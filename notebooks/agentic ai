 = pd.read_csv(zone_file)\n","\n","        required = [\n","            \"zone_name\",\n","            \"lat_min\",\n","            \"lat_max\",\n","            \"lon_min\",\n","            \"lon_max\"\n","        ]\n","\n","        for column in required:\n","\n","            if column not in self.zones.columns:\n","\n","                raise ValueError(\n","                    f\"Missing zone column: {column}\"\n","                )\n","\n","        print(\"Intrusion zones loaded successfully\")\n","        print(\"Number of zones:\", len(self.zones))\n","\n","\n","    def check_position(self, latitude, longitude):\n","\n","        for _, zone in self.zones.iterrows():\n","\n","            inside = (\n","                latitude >= zone[\"lat_min\"]\n","                and\n","                latitude <= zone[\"lat_max\"]\n","                and\n","                longitude >= zone[\"lon_min\"]\n","                and\n","                longitude <= zone[\"lon_max\"]\n","            )\n","\n","            if inside:\n","\n","                return (\n","                    \"INTRUSION\",\n","                    zone[\"zone_name\"]\n","                )\n","\n","        return \"NORMAL\", None\n","\n","\n","    def classify_record(self, row):\n","\n","        latitude = row[\"latitude\"]\n","        longitude = row[\"longitude\"]\n","\n","        # --------------------------------------------------\n","        # No AIS association\n","        # --------------------------------------------------\n","\n","        if not bool(row[\"ais_match\"]):\n","\n","            return (\n","                \"UNKNOWN_AIS\",\n","                None\n","            )\n","\n","        # --------------------------------------------------\n","        # Optional high-confidence mode\n","        # --------------------------------------------------\n","\n","        if self.reliable_only:\n","\n","            if row[\"match_quality\"] != \"reliable\":\n","\n","                return (\n","                    \"NORMAL_LOW_CONFIDENCE\",\n","                    None\n","                )\n","\n","        # --------------------------------------------------\n","        # Check surveillance zones\n","        # --------------------------------------------------\n","\n","        return self.check_position(\n","            latitude,\n","            longitude\n","        )\n","\n","\n","    def detect(\n","        self,\n","        input_file,\n","        output_file\n","    ):\n","\n","        print(\"\\nLoading matched vessel data...\")\n","\n","        df = pd.read_csv(input_file)\n","\n","        print(\n","            \"Total input records:\",\n","            len(df)\n","        )\n","\n","        required = [\n","            \"frame\",\n","            \"track_id\",\n","            \"latitude\",\n","            \"longitude\",\n","            \"ais_match\",\n","            \"match_quality\"\n","        ]\n","\n","        for column in required:\n","\n","            if column not in df.columns:\n","\n","                raise ValueError(\n","                    f\"Missing required column: {column}\"\n","                )\n","\n","        # --------------------------------------------------\n","        # Numeric conversion\n","        # --------------------------------------------------\n","\n","        df[\"latitude\"] = pd.to_numeric(\n","            df[\"latitude\"],\n","            errors=\"coerce\"\n","        )\n","\n","        df[\"longitude\"] = pd.to_numeric(\n","            df[\"longitude\"],\n","            errors=\"coerce\"\n","        )\n","\n","        # --------------------------------------------------\n","        # Classification\n","        # --------------------------------------------------\n","\n","        statuses = []\n","        zones = []\n","\n","        for _, row in df.iterrows():\n","\n","            status, zone = self.classify_record(\n","                row\n","            )\n","\n","            statuses.append(status)\n","            zones.append(zone)\n","\n","        df[\"intrusion_status\"] = statuses\n","        df[\"intrusion_zone\"] = zones\n","\n","        # --------------------------------------------------\n","        # Alert level\n","        # --------------------------------------------------\n","\n","        def alert_level(status):\n","\n","            if status == \"INTRUSION\":\n","                return \"HIGH\"\n","\n","            if status == \"UNKNOWN_AIS\":\n","                return \"MEDIUM\"\n","\n","            if status == \"NORMAL_LOW_CONFIDENCE\":\n","                return \"LOW\"\n","\n","            return \"NONE\"\n","\n","        df[\"alert_level\"] = (\n","            df[\"intrusion_status\"]\n","            .apply(alert_level)\n","        )\n","\n","        # --------------------------------------------------\n","        # Save\n","        # --------------------------------------------------\n","\n","        os.makedirs(\n","            os.path.dirname(output_file),\n","            exist_ok=True\n","        )\n","\n","        df.to_csv(\n","            output_file,\n","            index=False\n","        )\n","\n","        # --------------------------------------------------\n","        # Statistics\n","        # --------------------------------------------------\n","\n","        print(\"\\n========================================\")\n","        print(\"INTRUSION DETECTION RESULTS\")\n","        print(\"========================================\")\n","\n","        print(\n","            \"Total records:\",\n","            len(df)\n","        )\n","\n","        print(\"\\nStatus distribution:\")\n","\n","        print(\n","            df[\"intrusion_status\"]\n","            .value_counts()\n","        )\n","\n","        print(\"\\nAlert distribution:\")\n","\n","        print(\n","            df[\"alert_level\"]\n","            .value_counts()\n","        )\n","\n","        print(\n","            \"\\nIntrusion records:\",\n","            (\n","                df[\"intrusion_status\"]\n","                == \"INTRUSION\"\n","            ).sum()\n","        )\n","\n","        print(\n","            \"Unknown AIS records:\",\n","            (\n","                df[\"intrusion_status\"]\n","                == \"UNKNOWN_AIS\"\n","            ).sum()\n","        )\n","\n","        print(\"\\nIntrusions by zone:\")\n","\n","        intrusion_df = df[\n","            df[\"intrusion_status\"]\n","            == \"INTRUSION\"\n","        ]\n","\n","        if len(intrusion_df) > 0:\n","\n","            print(\n","                intrusion_df[\n","                    \"intrusion_zone\"\n","                ].value_counts()\n","            )\n","\n","        else:\n","\n","            print(\"No intrusions detected\")\n","\n","        print(\n","            \"\\nOutput saved to:\",\n","            output_file\n","        )\n","\n","        return df\n","\n","\n","# ============================================================\n","# CONFIGURATION\n","# ============================================================\n","\n","MATCHED_FILE = (\n","    \"/content/drive/MyDrive/ResearchProject/ais/\"\n","    \"matched_vessels.csv\"\n",")\n","\n","ZONE_FILE = (\n","    \"/content/drive/MyDrive/ResearchProject/\"\n","    \"agentic_ai/intrusion_zones.csv\"\n",")\n","\n","OUTPUT_FILE = (\n","    \"/content/drive/MyDrive/ResearchProject/\"\n","    \"agentic_ai/outputs/intrusion_results.csv\"\n",")\n","\n","\n","# ============================================================\n","# RUN\n","# ============================================================\n","\n","if __name__ == \"__main__\":\n","\n","    detector = IntrusionDetector(\n","        zone_file=ZONE_FILE,\n","\n","        # Use all AIS associations for the first\n","        # pipeline test.\n","        reliable_only=False\n","    )\n","\n","    result = detector.detect(\n","        input_file=MATCHED_FILE,\n","        output_file=OUTPUT_FILE\n","    )\n","\n","    print(\"\\nSamp