     }\n","\n","        # --------------------------------------------------\n","        # Intrusion + critical encounter\n","        # --------------------------------------------------\n","\n","        if (\n","            intrusion_status == \"INTRUSION\"\n","            and risk_level == \"CRITICAL\"\n","        ):\n","            return {\n","                \"navigation_action\":\n","                    self._convert_encounter_action(\n","                        recommended_action\n","                    ),\n","                \"navigation_priority\": \"CRITICAL\",\n","                \"navigation_reason\":\n","                    \"Vessel is inside the surveillance zone \"\n","                    \"and presents a critical navigation risk.\"\n","            }\n","\n","        # --------------------------------------------------\n","        # Critical encounter\n","        # --------------------------------------------------\n","\n","        if risk_level == \"CRITICAL\":\n","            return {\n","                \"navigation_action\":\n","                    self._convert_encounter_action(\n","                        recommended_action\n","                    ),\n","                \"navigation_priority\": \"CRITICAL\",\n","                \"navigation_reason\":\n","                    \"Critical collision or encounter risk detected.\"\n","            }\n","\n","        # --------------------------------------------------\n","        # High risk encounter\n","        # --------------------------------------------------\n","\n","        if risk_level == \"HIGH\":\n","            return {\n","                \"navigation_action\":\n","                    self._convert_encounter_action(\n","                        recommended_action\n","                    ),\n","                \"navigation_priority\": \"HIGH\",\n","                \"navigation_reason\":\n","                    f\"High-risk vessel encounter detected: \"\n","                    f\"{encounter_type}.\"\n","            }\n","\n","        # --------------------------------------------------\n","        # Moderate risk\n","        # --------------------------------------------------\n","\n","        if risk_level == \"MODERATE\":\n","            return {\n","                \"navigation_action\":\n","                    self._convert_encounter_action(\n","                        recommended_action\n","                    ),\n","                \"navigation_priority\": \"MEDIUM\",\n","                \"navigation_reason\":\n","                    f\"Moderate navigation risk detected from \"\n","                    f\"a {encounter_type} encounter.\"\n","            }\n","\n","        # --------------------------------------------------\n","        # Intrusion\n","        # --------------------------------------------------\n","\n","        if (\n","            intrusion_status == \"INTRUSION\"\n","            and alert_level == \"HIGH\"\n","        ):\n","            return {\n","                \"navigation_action\": \"ALERT_AND_MONITOR\",\n","                \"navigation_priority\": \"HIGH\",\n","                \"navigation_reason\":\n","                    \"Vessel has entered the surveillance zone \"\n","                    \"and requires monitoring.\"\n","            }\n","\n","        # --------------------------------------------------\n","        # Safe\n","        # --------------------------------------------------\n","\n","        if (\n","            encounter_type == \"SAFE\"\n","            or recommended_action == \"MAINTAIN_COURSE\"\n","        ):\n","            return {\n","                \"navigation_action\": \"CONTINUE\",\n","                \"navigation_priority\": \"NONE\",\n","                \"navigation_reason\":\n","                    \"No immediate navigation threat detected.\"\n","            }\n","\n","        # --------------------------------------------------\n","        # Fallback\n","        # --------------------------------------------------\n","\n","        return {\n","            \"navigation_action\": \"MONITOR\",\n","            \"navigation_priority\": \"LOW\",\n","            \"navigation_reason\":\n","                \"Situation requires continued observation.\"\n","        }\n","\n","    def _convert_encounter_action(self, action):\n","\n","        if action == \"TURN_LEFT\":\n","            return \"TURN_LEFT\"\n","\n","        if action == \"TURN_RIGHT\":\n","            return \"TURN_RIGHT\"\n","\n","        if action == \"SLOW_DOWN\":\n","            return \"SLOW_DOWN\"\n","\n","        if action == \"STOP\":\n","            return \"STOP\"\n","\n","        if action == \"MAINTAIN_COURSE\":\n","            return \"CONTINUE\"\n","\n","        return \"MONITOR\"\n","\n","    def process(self, input_file, output_file):\n","\n","        print(\"=\" * 70)\n","        print(\"NAVIGATION DECISION PROCESSING\")\n","        print(\"=\" * 70)\n","\n","        df = pd.read_csv(input_file)\n","\n","        print(\"Total records:\", len(df))\n","\n","        required_columns = [\n","            \"intrusion_status\",\n","            \"alert_level\",\n","            \"encounter_type\",\n","            \"risk_level\",\n","            \"recommended_action\"\n","        ]\n","\n","        missing = [\n","            c for c in required_columns\n","            if c not in df.columns\n","        ]\n","\n","        if missing:\n","            raise ValueError(\n","                f\"Missing required columns: {missing}\"\n","            )\n","\n","        results = []\n","\n","        for _, row in df.iterrows():\n","            results.append(\n","                self.decide(row)\n","            )\n","\n","        navigation_df = pd.DataFrame(results)\n","\n","        output = pd.concat(\n","            [\n","                df.reset_index(drop=True),\n","                navigation_df.reset_index(drop=True)\n","            ],\n","            axis=1\n","        )\n","\n","        os.makedi