er()\n","\n","        recommended_action = str(\n","            row.get(\"recommended_action\", \"MAINTAIN_COURSE\")\n","        ).upper()\n","\n","        # ======================================================\n","        # 1. CRITICAL INTRUSION\n","        # ======================================================\n","\n","        if severity == \"CRITICAL\":\n","\n","            return {\n","                \"navigation_action\":\n","                    \"IMMEDIATE_ATTENTION\",\n","\n","                \"navigation_priority\":\n","                    \"CRITICAL\",\n","\n","                \"navigation_reason\":\n","                    \"Critical vessel intrusion detected.\"\n","            }\n","\n","        # ======================================================\n","        # 2. HIGH-RISK INTRUSION\n","        # ======================================================\n","\n","        if (\n","            intrusion_type == \"UNAUTHORIZED_ENTRY\"\n","            or decision == \"ALERT\"\n","        ):\n","\n","            if recommended_action == \"TURN_LEFT\":\n","\n","                action = \"ALERT_AND_TURN_LEFT\"\n","\n","            elif recommended_action == \"TURN_RIGHT\":\n","\n","                action = \"ALERT_AND_TURN_RIGHT\"\n","\n","            elif recommended_action == \"STOP\":\n","\n","                action = \"ALERT_AND_STOP\"\n","\n","            elif recommended_action == \"SLOW_DOWN\":\n","\n","                action = \"ALERT_AND_SLOW_DOWN\"\n","\n","            else:\n","\n","                action = \"ALERT_AND_MONITOR\"\n","\n","            return {\n","                \"navigation_action\": action,\n","\n","                \"navigation_priority\": \"HIGH\",\n","\n","                \"navigation_reason\":\n","                    \"Unauthorized vessel intrusion combined \"\n","                    \"with encounter risk.\"\n","            }\n","\n","        # ======================================================\n","        # 3. AIS UNKNOWN VESSEL\n","        # ======================================================\n","\n","        if (\n","            intrusion_type == \"AIS_UNIDENTIFIED\"\n","            or decision == \"MONITOR\"\n","        ):\n","\n","            return {\n","                \"navigation_action\":\n","                    \"CONTINUE_OBSERVATION\",\n","\n","                \"navigation_priority\":\n","                    \"MEDIUM\",\n","\n","                \"navigation_reason\":\n","                    \"Vessel detected without a reliable AIS \"\n","                    \"association.\"\n","            }\n","\n","        # ======================================================\n","        # 4. NORMAL VESSEL BUT CRITICAL ENCOUNTER\n","        # ======================================================\n","\n","        if risk_level == \"CRITICAL\":\n","\n","            if recommended_action == \"TURN_LEFT\":\n","\n","                action = \"TURN_LEFT\"\n","\n","            elif recommended_action == \"TURN_RIGHT\":\n","\n","                action = \"TURN_RIGHT\"\n","\n","            elif recommended_action == \"STOP\":\n","\n","                action = \"STOP\"\n","\n","            elif recommended_action == \"SLOW_DOWN\":\n","\n","                action = \"SLOW_DOWN\"\n","\n","            else:\n","\n","                action = \"IMMEDIATE_ATTENTION\"\n","\n","            return {\n","                \"navigation_action\": action,\n","\n","                \"navigation_priority\":\n","                    \"CRITICAL\",\n","\n","                \"navigation_reason\":\n","                    \"Critical collision-risk encounter detected.\"\n","            }\n","\n","        # ======================================================\n","        # 5. HIGH ENCOUNTER RISK\n","        # ======================================================\n","\n","        if risk_level == \"HIGH\":\n","\n","            if recommended_action == \"TURN_LEFT\":\n","\n","                action = \"TURN_LEFT\