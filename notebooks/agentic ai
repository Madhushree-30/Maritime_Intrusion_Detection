URN_LEFT\",\n","        \"TURN_RIGHT\",\n","        \"MAINTAIN_COURSE\"\n","    ]\n","\n","    def __init__(self):\n","\n","        print(\"Maritime Action Agent initialized\")\n","\n","\n","    # =====================================================\n","    # OBSERVE\n","    # =====================================================\n","\n","    def observe(self, row):\n","\n","        return {\n","            \"track_id\": row.get(\"track_id\"),\n","            \"mmsi\": row.get(\"MMSI\"),\n","\n","            \"latitude\": self.number(\n","                row.get(\"latitude\")\n","            ),\n","\n","            \"longitude\": self.number(\n","                row.get(\"longitude\")\n","            ),\n","\n","            \"speed\": self.number(\n","                row.get(\"Speed\", row.get(\"SOG\", 0))\n","            ),\n","\n","            \"heading\": self.number(\n","                row.get(\"heading_deg\",\n","                        row.get(\"Heading\", 0))\n","            ),\n","\n","            \"intrusion\": row.get(\n","                \"intrusion\",\n","                False\n","            ),\n","\n","            \"intrusion_type\": row.get(\n","                \"intrusion_type\",\n","                \"NORMAL\"\n","            ),\n","\n","            \"severity\": row.get(\n","                \"severity\",\n","                \"NONE\"\n","            ),\n","\n","            \"ais_state\": row.get(\n","                \"ais_state\",\n","                \"UNKNOWN\"\n","            ),\n","\n","            \"match_quality\": row.get(\n","                \"match_quality\",\n","                \"unmatched\"\n","            ),\n","\n","            \"distance_to_ais_km\": self.number(\n","                row.get(\"distance_to_ais_km\")\n","            )\n","        }\n","\n","\n","    # =====================================================\n","    # UTILITY\n","    # =====================================================\n","\n","    @staticmethod\n","    def number(value):\n","\n","        try:\n","\n","            if pd.isna(value):\n","                return 0.0\n","\n","            return float(value)\n","\n","        except:\n","\n","            return 0.0\n","\n","\n","    # =====================================================\n","    # RISK ASSESSMENT\n","    # =====================================================\n","\n","    def assess_risk(self, state):\n","\n","        risk = 0.0\n","        reasons = []\n","\n","        if state[\"intrusion\"] is True:\n","\n","            risk += 50\n","\n","            reasons.append(\n","                \"vessel is inside surveillance zone\"\n","            )\n","\n","        if state[\"severity\"] == \"CRITICAL\":\n","\n","            risk += 40\n","\n","            reasons.append(\n","                \"critical intrusion condition\"\n","            )\n","\n","        elif state[\"severity\"] == \"HIGH\":\n","\n","            risk += 25\n","\n","            reasons.append(\n","                \"high severity intrusion\"\n","            )\n","\n","        elif state[\"severity\"] == \"MEDIUM\":\n","\n","            risk += 10\n","\n","            reasons.append(\n","                \"medium uncertainty\"\n","            )\n","\n","        if state[\"ais_state\"] == \"UNKNOWN\":\n","\n","            risk += 20\n","\n","            reasons.append(\n","                \"AIS identity is unknown\"\n","            )\n","\n","        if state[\"match_quality\"] == \"weak\":\n","\n","            risk += 10\n","\n","            reasons.append(\n","                \"weak AIS association\"\n","            )\n","\n","        # Cap risk at 100\n","        risk = min(risk, 100)\n","\n","        return risk, reasons\n","\n","\n","    # =====================================================\n","    # ACTION SCORING\n","    # =====================================================\n","\n","    def score_actions(self, state, risk):\n","\n","        scores = {\n","            \"STOP\": 0.0,\n","            \"SLOW_DOWN\": 0.0,\n","            \"TURN_LEFT\": 0.0,\n","            \"TURN_RIGHT\": 0.0,\n","            \"MAINTAIN_COURSE\": 0.0\n","        }\n","\n","        explanations = {}\n","\n","        # -------------------------------------------------\n","        # Normal situation\n","        # -------------------------------------------------\n","\n","        if risk < 20:\n","\n","            scores[\"MAINTAIN_COURSE\"] += 80\n","\n","            explanations[\n","                \"MAINTAIN_COURSE\"\n","            ] = \"Low assessed risk.\"\n","\n","            scores[\"SLOW_DOWN\"] += 20\n","\n","            explanations[\n","                \"SLOW_DOWN\"\n","            ] = \"Conservative alternative.\"\n","\n","        # -------------------------------------------------\n","        # Moderate risk\n","        # -------------------------------------------------\n","\n","        elif risk < 50:\n","\n","            scores[\"SLOW_DOWN\"] += 60\n","\n","            explanations[\n","                \"SLOW_DOWN\"\n","            ] = (\n","                \"Reducing speed provides more \"\n","                \"time for observation and response.\"\n","            )\n","\n","            scores[\"TURN_LEFT\"] += 40\n","            scores[\"TURN_RIGHT\"] += 40\n","\n","            explanations[\n","                \"TURN_LEFT\"\n","            ] = \"Course alteration can reduce exposure.\"\n","\n","            explanations[\n","                \"TURN_RIGHT\"\n","            ] = \"Course alteration can reduce exposure.\"\n","\n","        # -------------------------------------------------\n","        # High risk\n","        # -------------------------------------------------\n","\n","        elif risk < 80:\n","\n","            scores[\"SLOW_DOWN\"] += 55\n","\n","            scores[\"TURN_LEFT\"] += 65\n","            scores[\"TURN_RIGHT\"] += 65\n","\n","            explanations[\n","                \"SLOW_DOWN\"\n","            ] = \"High risk requires conservative motion.\"\n","\n","            explanations[\n","                \"TURN_LEFT\"\n","            ] = \"Avoid continuing the current course.\"\n","\n","            explanations[\n","                \"TURN_RIGHT\"\n","            ] = \"Avoid continuing the current course.\"\n","\n","            scores[\"STOP\"] += 50\n","\n","            explanations[\n","                \"STOP\"\n","            ] = \"Stopping provides maximum reaction time.\"\n","\n","        # -------------------------------------------------\n","        # Critical risk\n","        # -------------------------------------------------\n","\n","        else:\n","\n","            scores[\"STOP\"] += 100\n","\n","            explanations[\n","                \"STOP\"\n","            ] = (\n","                \"Critical risk; stopping is the \"\n","                \"most conservative research action.\"\n","            )\n","\n","            scores[\"TURN_LEFT\"] += 70\n","            scores[\"TURN_RIGHT\"] += 70\n","\n","            explanations[\n","                \"TURN_LEFT\"\n","            ] = \"Emergency course alteration candidate.\"\n","\n","            explanations[\n","                \"TURN_RIGHT\"\n","            ] = \"Emergency course alteration candidate.\"\n","\n","        return scores, explanations\n","\n","\n","    # =====================================================\n","    # DECISION\n","    # =====================================================\n","\n","    def choose_action(\n","        self,\n","        state,\n","        risk,\n","        scores,\n","        explanations\n","    ):\n","\n","        # Highest score wins\n","        action = max(\n","            scores,\n","            key=scores.get\n","        )\n","\n","        max_score = scores[action]\n","\n","        # Convert score to approximate\n","        # decision confidence.\n","        confidence = min(\n","            max_score / 100.0,\n","            1.0\n","        )\n","\n","        return {\n","            \"recommended_action\": action,\n","            \"action_score\": round(\n","                max_score,\n","                2\n","            ),\n","            \"action_confidence\": round(\n","                confidence,\n","                3\n","            ),\n","            \"reason\": explanations[action]\n","        }\n","\n","\n","    # =====================================================\n","    # COMPLETE AGENT CYCLE\n","    # =====================================================\n","\n","    def run(self, row):\n","\n","        # 1. Observe\n","        state = self.observe(row)\n","\n","        # 2. Assess\n","        risk, risk_reasons = (\n","            self.assess_risk(state)\n","        )\n","\n","        # 3. Generate and score actions\n","        scores, explanations = (\n","            self.score_actions(\n","                state,\n","                risk\n","            )\n","        )\n","\n","        # 4. Select action\n","        decision = self.choose_action(\n","            state,\n","            risk,\n","            scores,\n","            explanations\n","        )\n","\n","        result = {}\n","\n","        result.update(state)\n","\n","        result[\"risk_score\"] = round(\n","            risk,\n","            2\n","        )\n","\n","        result[\"risk_reasons\"] = (\n","            \"; \".join(risk_reasons)\n","        )\n","\n","        result.update(decision)\n","\n","        return result\n","\n","\n","    # =====================================================\n","    # DATASET PROCESSING\n","    # =====================================================\n","\n","    def process(\n","        self,\n","        input_file,\n","        output_file\n","    ):\n","\n","        print(\n","            \"\\nLoading Agentic AI observations...\"\n","        )\n","\n","        df = pd.read_csv(\n","            input_file\n","        )\n","\n","        print(\n","            \"Input records:\",\n","            len(df)\n","        )\n","\n","        results = []\n","\n","        for _, row in df.iterrows():\n","\n","            result = self.run(row)\n","\n","            results.append(result)\n","\n","        output = pd.DataFrame(\n","            results\n","        )\n","\n","        output.to_csv(\n","            output_file,\n","            index=False\n","        )\n","\n","        print(\n","            \"\\n======================================\"\n","        )\n","\n","        print(\n","            \"AGENTIC ACTION PLANNING RESULTS\"\n","        )\n","\n","        print(\n","            \"======================================\"\n","        )\n","\n","        print(\n","            \"\\nRecommended actions:\"\n","        )\n","\n","        print(\n","            output[\n","                \"recommended_action\"\n","            ].value_counts()\n","        )\n","\n","        print(\n","            \"\\nRisk distribution:\"\n","        )\n","\n","        print(\n","            output[\n","                \"risk_score\"\n","            ].describe()\n","        )\n","\n","        print(\n","            \"\\nOutput saved to:\"\n","        )\n","\n","        print(output_file)\n","\n","        return output"]},{"cell_type":"code","execution_count":null,"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"executionInfo":{"elapsed":190,"status":"ok","timestamp":1787214820370,"user":{"displayName":"MADHU SHREE T 23ADR099","userId":"11834266471021201390"},"user_tz":-330},"id":"onHxApxwTeby","outputId":"937965f4-540c-4cc0-9df2-d2dd0af486f8"},"outputs":[{"name":"stdout","output_type":"stream","text":["Maritime Action Agent initialized\n","\n","Loading Agentic AI observations...\n","Input records: 1529\n","\n","======================================\n","AGENTIC ACTION PLANNING RESULTS\n","======================================\n","\n","Recommended actions:\n","recommended_action\n","MAINTAIN_COURSE    842\n","TURN_LEFT          399\n","STOP               279\n","SLOW_DOWN            9\n","Name: count, dtype: int64\n","\n","Risk distribution:\n","count    1529.000000\n","mean       37.560497\n","std        37.479057\n","min         0.000000\n","25%         0.000000\n","50%        10.000000\n","75%        75.000000\n","max        85.000000\n","Name: risk_score, dtype: float64\n","\n","Output saved to:\n","/content/drive/MyDrive/ResearchProject/agentic_ai/outputs/action_decisions.csv\n"]}],"source":["from action_planner import MaritimeActionAgent\n","\n","INPUT = (\n","    \"/content/drive/MyDrive/ResearchProject/\"\n","    \"agentic_ai/outputs/agent_decisions.csv\"\n",")\n","\n","OUTPUT = (\n","    \"/content/drive/MyDrive/ResearchProject/\"\n","    \"agentic_ai/outputs/action_decisions.csv\"\n",")\n","\n","agent = MaritimeActionAgent()\n","\n","result = agent.process(\n","    INPUT,\n","    OUTPUT\n",")"]},{"cell_type":"code","execution_count":null,"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"executionInfo":{"elapsed":15,"status":"ok","timestamp":1787214832411,"user":{"displayName":"MADHU SHREE T 23ADR099","userId":"11834266471021201390"},"user_tz":-330},"id":"zFBhgOnWThYc","outputId":"5551c6ec-5727-49a5-9446-2672955a398d"},"outputs":[{"name":"stdout","output_type":"stream","text":[" track_id        mmsi  intrusion intrusion_type severity  risk_score recommended_action  action_confidence             reason\n","        2 215347000.0      False         NORMAL     NONE         0.0    MAINTAIN_COURSE                0.8 Low assessed risk.\n","        1 215347000.0      False         NORMAL     NONE         0.0    MAINTAIN_COURSE                0.8 Low assessed risk.\n","        4 215347000.0      False         NORMAL     NONE         0.0    MAINTAIN_COURSE                0.8 Low assessed risk.\n","        1 215347000.0      False         NORMAL     NONE         0.0    MAINTAIN_COURSE                0.8 Low assessed risk.\n","        3 215347000.0      False         NORMAL     NONE         0.0    MAINTAIN_COURSE                0.8 Low