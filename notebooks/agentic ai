"\"\n","    Agentic AI controller for maritime surveillance.\n","\n","    The agent:\n","        1. Observes vessel information\n","        2. Assesses the situation\n","        3. Reasons about intrusion conditions\n","        4. Classifies the event\n","        5. Selects an action\n","    \"\"\"\n","\n","    def __init__(self, intrusion_zone_file):\n","\n","        self.zones = pd.read_csv(\n","            intrusion_zone_file\n","        )\n","\n","        print(\"Maritime Agent initialized\")\n","        print(\n","            f\"Surveillance zones: {len(self.zones)}\"\n","        )\n","\n","\n","    # =====================================================\n","    # OBSERVE\n","    # =====================================================\n","\n","    def observe(self, row):\n","\n","        observation = {\n","\n","            \"track_id\": row.get(\n","                \"track_id\",\n","                None\n","            ),\n","\n","            \"MMSI\": row.get(\n","                \"MMSI\",\n","                None\n","            ),\n","\n","            \"latitude\": row.get(\n","                \"latitude\",\n","                None\n","            ),\n","\n","            \"longitude\": row.get(\n","                \"longitude\",\n","                None\n","            ),\n","\n","            \"speed\": row.get(\n","                \"Speed\",\n","                row.get(\"SOG\", None)\n","            ),\n","\n","            \"heading\": row.get(\n","                \"heading_deg\",\n","                row.get(\"Heading\", None)\n","            ),\n","\n","            \"ais_match\": row.get(\n","                \"ais_match\",\n","                False\n","            ),\n","\n","            \"match_quality\": row.get(\n","                \"match_quality\",\n","                \"unmatched\"\n","            ),\n","\n","            \"distance_to_ais_km\": row.get(\n","                \"distance_to_ais_km\",\n","                None\n","            ),\n","\n","            \"intrusion_status\": row.get(\n","                \"intrusion_status\",\n","                \"NORMAL\"\n","            ),\n","\n","            \"intrusion_zone\": row.get(\n","                \"intrusion_zone\",\n","                None\n","            )\n","        }\n","\n","        return observation\n","\n","\n","    # =====================================================\n","    # ASSESS\n","    # =====================================================\n","\n","    def assess(self, observation):\n","\n","        assessment = {}\n","\n","        # -----------------------------------------------\n","        # AIS assessment\n","        # -----------------------------------------------\n","\n","        if observation[\"ais_match\"]:\n","\n","            assessment[\"ais_state\"] = \"IDENTIFIED\"\n","\n","        else:\n","\n","            assessment[\"ais_state\"] = \"UNKNOWN\"\n","\n","\n","        # -----------------------------------------------\n","        # Match confidence\n","        # -----------------------------------------------\n","\n","        quality = observation[\"match_quality\"]\n","\n","        if quality == \"reliable\":\n","\n","            assessment[\"identity_confidence\"] = \"HIGH\"\n","\n","        elif quality == \"moderate\":\n","\n","            assessment[\"identity_confidence\"] = \"MEDIUM\"\n","\n","        elif quality == \"weak\":\n","\n","            assessment[\"identity_confidence\"] = \"LOW\"\n","\n","        else:\n","\n","            assessment[\"identity_confidence\"] = \"NONE\"\n","\n","\n","        # -----------------------------------------------\n","        # Zone assessment\n","        # -----------------------------------------------\n","\n","        if (\n","            observation[\"intrusion_status\"]\n","            == \"INTRUSION\"\n","        ):\n","\n","            assessment[\"zone_state\"] = \"INSIDE\"\n","\n","        else:\n","\n","            assessment[\"zone_state\"] = \"OUTSIDE\"\n","\n","\n","        return assessment\n","\n","\n","    # =====================================================\n","    # REASON\n","    # =====================================================\n","\n","    def reason(self, observation, assessment):\n","\n","        # -------------------------------------------------\n","        # Case 1: confirmed intrusion\n","        # -------------------------------------------------\n","\n","        if assessment[\"zone_state\"] == \"INSIDE\":\n","\n","            if assessment[\"ais_state\"] == \"IDENTIFIED\":\n","\n","                intrusion_type = (\n","                    \"UNAUTHORIZED_ENTRY\"\n","                )\n","\n","                severity = \"HIGH\"\n","\n","                reason = (\n","                    \"Identified vessel detected \"\n","                    \"inside the surveillance zone.\"\n","                )\n","\n","            else:\n","\n","                intrusion_type = (\n","                    \"UNKNOWN_VESSEL_INTRUSION\"\n","                )\n","\n","                severity = \"CRITICAL\"\n","\n","                reason = (\n","                    \"Vessel detected inside the \"\n","                    \"surveillance zone without \"\n","                    \"a reliable AIS identity.\"\n","                )\n","\n","            return {\n","                \"intrusion\": True,\n","                \"intrusion_type\": intrusion_type,\n","                \"severity\": severity,\n","                \"reason\": reason\n","            }\n","\n","\n","        # -------------------------------------------------\n","        # Case 2: no AIS association\n","        # -------------------------------------------------\n","\n","        if assessment[\"ais_state\"] == \"UNKNOWN\":\n","\n","            return {\n","                \"intrusion\": False,\n","                \"intrusion_type\": \"AIS_UNIDENTIFIED\",\n","                \"severity\": \"MEDIUM\",\n","                \"reason\": (\n","                    \"Vessel detected but no reliable \"\n","                    \"AIS association was available.\"\n","                )\n","            }\n","\n","\n","        # -------------------------------------------------\n","        # Case 3: normal\n","        # -------------------------------------------------\n","\n","        return {\n","            \"intrusion\": False,\n","            \"intrusion_type\": \"NORMAL\",\n","            \"severity\": \"NONE\",\n","            \"reason\": (\n","                \"No intrusion condition detected.\"\n","            )\n","        }\n","\n","\n","    # =====================================================\n","    # DECIDE\n","    # =====================================================\n","\n","    def decide(self, reasoning):\n","\n","        if reasoning[\"severity\"] == \"CRITICAL\":\n","\n","            return {\n","                \"decision\": \"HIGH_PRIORITY_ALERT\",\n","                \"action\": \"IMMEDIATE_ATTENTION\"\n","            }\n","\n","        if reasoning[\"severity\"] == \"HIGH\":\n","\n","            return {\n","                \"decision\": \"ALERT\",\n","                \"action\": \"MONITOR_VESSEL\"\n","            }\n","\n","        if reasoning[\"severity\"] == \"MEDIUM\":\n","\n","            return {\n","                \"decision\": \"MONITOR\",\n","                \"action\": \"CONTINUE_OBSERVATION\"\n","            }\n","\n","        return {\n","            \"decision\": \"NORMAL\",\n","            \"action\": \"NO_ACTION\"\n","        }\n","\n","\n","    # =====================================================\n","    # COMPLETE AGENT CYCLE\n","    # =====================================================\n","\n","    def run(self, row):\n","\n","        # 1. Observe\n","        observation = self.observe(row)\n","\n","        # 2. Assess\n","        assessment = self.assess(\n","            observation\n","        )\n","\n","        # 3. Reason\n","        reasoning = self.reason(\n","            observation,\n","            assessment\n","        )\n","\n","        # 4. Decide\n","        decision = self.decide(\n","            reasoning\n","        )\n","\n","        # Combine everything\n","        result = {}\n","\n","        result.update(observation)\n","        result.update(assessment)\n","        result.update(reasoning)\n","        result.update(decision)\n","\n","        return result\n","\n","\n","    # =====================================================\n","    # PROCESS COMPLETE DATASET\n","    # =====================================================\n","\n","    def process(\n","        self,\n","        input_file,\n","        output_file\n","    ):\n","\n","        print(\n","            \"\\nLoading surveillance observations...\"\n","        )\n","\n","        df = pd.read_csv(\n","            input_file\n","        )\n","\n","        print(\n","            f\"Input records: {len(df)}\"\n","        )\n","\n","        results = []\n","\n","        for _, row in df.iterrows():\n","\n","            result = self.run(row)\n","\n","            results.append(result)\n","\n","        result_df = pd.DataFrame(\n","            results\n","        )\n","\n","        os.makedirs(\n","            os.path.dirname(output_file),\n","            exist_ok=True\n","        )\n","\n","        result_df.to_csv(\n","            output_file,\n","            index=False\n","        )\n","\n","        # -------------------------------------------------\n","        # Statistics\n","        # -------------------------------------------------\n","\n","        print(\n","            \"\\n======================================\"\n","        )\n","\n","        print(\n","            \"AGENTIC AI RESULTS\"\n","        )\n","\n","        print(\n","            \"======================================\"\n","        )\n","\n","        print(\n","            f\"Total observations: {len(result_df)}\"\n","        )\n","\n","        print(\n","            \"\\nIntrusion distribut