er":{"displayName":"MADHU SHREE T 23ADR099","userId":"11834266471021201390"},"user_tz":-330},"id":"9KJtcsbYWVrN","outputId":"dcf46e26-2296-45c6-9bc4-5a010d504c15"},"outputs":[{"name":"stdout","output_type":"stream","text":["Writing /content/drive/MyDrive/ResearchProject/agentic_ai/speed_estimator.py\n"]}],"source":["%%writefile /content/drive/MyDrive/ResearchProject/agentic_ai/speed_estimator.py\n","\n","import math\n","import pandas as pd\n","\n","\n","INPUT_FILE = (\n","    \"/content/drive/MyDrive/ResearchProject/ais/\"\n","    \"georeferenced_detections.csv\"\n",")\n","\n","OUTPUT_FILE = (\n","    \"/content/drive/MyDrive/ResearchProject/agentic_ai/\"\n","    \"outputs/speed_estimated_detections.csv\"\n",")\n","\n","\n","def haversine_km(lat1, lon1, lat2, lon2):\n","    \"\"\"Calculate distance between two geographic coordinates.\"\"\"\n","\n","    R = 6371.0\n","\n","    lat1 = math.radians(lat1)\n","    lat2 = math.radians(lat2)\n","\n","    dlat = math.radians(lat2 - lat1)\n","    dlon = math.radians(lon2 - lon1)\n","\n","    a = (\n","        math.sin(dlat / 2) ** 2\n","        + math.cos(lat1)\n","        * math.cos(lat2)\n","        * math.sin(dlon / 2) ** 2\n","    )\n","\n","    return 2 * R * math.atan2(\n","        math.sqrt(a),\n","        math.sqrt(1 - a)\n","    )\n","\n","\n","def estimate_speed(group):\n","\n","    group = group.sort_values(\"frame\").copy()\n","\n","    speeds = [None]\n","\n","    previous = None\n","\n","    for _, row in group.iterrows():\n","\n","        if previous is None:\n","            previous = row\n","            continue\n","\n","        distance_km = haversine_km(\n","            previous[\"latitude\"],\n","            previous[\"longitude\"],\n","            row[\"latitude\"],\n","            row[\"longitude\"]\n","        )\n","\n","        frame_difference = (\n","            row[\"frame\"] - previous[\"frame\"]\n","        )\n","\n","        if frame_difference <= 0:\n","            speeds.append(None)\n","            previous = row\n","            continue\n","\n","        # Assumption:\n","        # dataset represents consecutive frames.\n","        #\n","        # If frame rate is 1 frame/sec:\n","        # time = frame_difference seconds.\n","        #\n","        # Convert km/sec -> knots.\n","\n","        time_seconds = frame_difference\n","\n","        speed_km_per_sec = (\n","            distance_km / time_seconds\n","        )\n","\n","        speed_km_per_hour = (\n","            speed_km_per_sec * 3600\n","        )\n","\n","        speed_knots = (\n","            speed_km_per_hour / 1.852\n","        )\n","\n","        speeds.append(speed_knots)\n","\n","        previous = row\n","\n","    group[\"estimated_speed_knots\"] = speeds\n","\n","    return group\n","\n","\n","# ---------------------------------------------------------\n","# Load data\n","# ---------------------------------------------------------\n","\n","df = pd.read_csv(INPUT_FILE)\n","\n","print(\"Input records:\", len(df))\n","\n","print(\"\\nInput columns:\")\n","print(df.columns.tolist())\n","\n","\n","# ---------------------------------------------------------\n","# Check required columns\n","# ---------------------------------------------------------\n","\n","required_columns = [\n","    \"track_id\",\n","    \"frame\",\n","    \"latitude\",\n","    \"longitude\"\n","]\n","\n","missing = [\n","    col\n","    for col in required_columns\n","    if col not in df.columns\n","]\n","\n","if missing:\n","    raise ValueError(\n","        f\"Missing required columns: {missing}\"\n","    )\n","\n","\n","# ---------------------------------------------------------\n","# Estimate speed for every track\n","# ---------------------------------------------------------\n","\n","df = (\n","    df.groupby(\n","        \"track_id\",\n","        group_keys=False\n","    )\n","    .apply(estimate_speed)\n","    .reset_index(drop=True)\n",")\n","\n","\n","# ---------------------------------------------------------\n","# Fill first observation of each track\n","# ---------------------------------------------------------\n","\n","df[\"estimated_speed_knots\"] = (\n","    df[\"estimated_speed_knots\"]\n","    .fillna(0)\n",")\n","\n","\n","# ---------------------------------------------------------\n","# Remove unrealistic speed spikes\n","#\n","# This is only a safety filter for tracking noise.\n","# ---------------------------------------------------------\n","\n","df.loc[\n","    df[\"estimated_speed_knots\"] > 50,\n","    \"estimated_speed_knots\"\n","] = float(\"nan\")\n","\n","\n","# Interpolate within each track\n","\n","df[\"estimated_speed_knots\"] = (\n","    df.groupby(\"track_id\")[\n","        \"estimated_speed_knots\"\n","    ]\n","    .transform(\n","        lambda x: x.replace(\n","            0,\n","            float(\"nan\")\n","        ).interpolate(\n","            limit_direction=\"both\"\n","        )\n","    )\n",")\n","\n","df[\"estimated_speed_knots\"] = (\n","    df[\"estimated_speed_knots\"]\n","    .fillna(0)\n",")\n","\n","\n","# ---------------------------------------------------------\n","# Save\n","# ---------------------------------------------------------\n","\n","df.to_csv(\n","    OUTPUT_FILE,\n","    index=False\n",")\n","\n","\n","# ---------------------------------------------------------\n","# Report\n","# ---------------------------------------------------------\n","\n","print(\"\\n================================\")\n","print(\"SPEED ESTIMATION COMPLETED\")\n","print(\"================================\")\n","\n","print(\n","    \"Output records:\",\n","    len(df)\n",")\n","\n","print(\n","    \"Unique tracks:\",\n","    df[\"track_id\"].nunique()\n",")\n","\n","print(\"\\nSpeed statistics (knots):\")\n","\n","print(\n","    df[\n","        \"estimated_speed_knots\"\n","    ].describe()\n",")\n","\n","print(\"\\nSample:\")\n","\n","print(\n","    df[\n","        [\n","            \"frame\",\n","            \"track_id\",\n","           