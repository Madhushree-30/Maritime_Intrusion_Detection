pd\n","\n","df = pd.read_csv(\n","    \"/content/drive/MyDrive/ResearchProject/\"\n","    \"agentic_ai/outputs/action_decisions.csv\"\n",")\n","\n","print(\n","    df[\n","        [\n","            \"track_id\",\n","            \"mmsi\",\n","            \"intrusion\",\n","            \"intrusion_type\",\n","            \"severity\",\n","            \"risk_score\",\n","            \"recommended_action\",\n","            \"action_confidence\",\n","            \"reason\"\n","        ]\n","    ].head(20).to_string(index=False)\n",")"]},{"cell_type":"code","execution_count":null,"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"executionInfo":{"elapsed":44,"status":"ok","timestamp":1787214910844,"user":{"displayName":"MADHU SHREE T 23ADR099","userId":"11834266471021201390"},"user_tz":-330},"id":"6ul8NFG8T0VR","outputId":"7704fe29-d59b-4c24-b5f3-9feac856348f"},"outputs":[{"name":"stdout","output_type":"stream","text":["Writing /content/drive/MyDrive/ResearchProject/agentic_ai/multi_vessel_reasoner.py\n"]}],"source":["%%writefile /content/drive/MyDrive/ResearchProject/agentic_ai/multi_vessel_reasoner.py\n","\n","import math\n","import pandas as pd\n","\n","\n","class MultiVesselReasoner:\n","\n","    def __init__(\n","        self,\n","        proximity_km=2.0,\n","        critical_distance_km=0.5\n","    ):\n","        self.proximity_km = proximity_km\n","        self.critical_distance_km = critical_distance_km\n","\n","        print(\"Multi-vessel reasoning module initialized\")\n","\n","\n","    # --------------------------------------------------\n","    # Distance between two geographic positions\n","    # --------------------------------------------------\n","\n","    def distance_km(\n","        self,\n","        lat1,\n","        lon1,\n","        lat2,\n","        lon2\n","    ):\n","\n","        R = 6371.0\n","\n","        lat1 = math.radians(lat1)\n","        lat2 = math.radians(lat2)\n","\n","        dlat = math.radians(lat2 - lat1)\n","        dlon = math.radians(lon2 - lon1)\n","\n","        a = (\n","            math.sin(dlat / 2) ** 2\n","            +\n","            math.cos(lat1)\n","            * math.cos(lat2)\n","            * math.sin(dlon / 2) ** 2\n","        )\n","\n","        return R * 2 * math.atan2(\n","            math.sqrt(a),\n","            math.sqrt(1 - a)\n","        )\n","\n","\n","    # --------------------------------------------------\n","    # Bearing from vessel A to vessel B\n","    # --------------------------------------------------\n","\n","    def bearing(\n","        self,\n","        lat1,\n","        lon1,\n","        lat2,\n","        lon2\n","    ):\n","\n","        lat1 = math.radians(lat1)\n","        lat2 = math.radians(lat2)\n","\n","        dlon = math.radians(\n","            lon2 - lon1\n","        )\n","\n","        x = (\n","            math.sin(dlon)\n","            * math.cos(lat2)\n","        )\n","\n","        y = (\n","            math.cos(lat1)\n","            * math.sin(lat2)\n","            -\n","            math.sin(lat1)\n","            * math.cos(lat2)\n","            * math.cos(dlon)\n","        )\n","\n","        bearing = math.degrees(\n","            math.atan2(x, y)\n","        )\n","\n","        return (bearing + 360) % 360\n","\n","\n","    # --------------------------------------------------\n","    # Difference between two headings\n","    # --------------------------------------------------\n","\n","    def heading_difference(\n","        self,\n","        h1,\n","        h2\n","    ):\n","\n","        diff = abs(h1 - h2)\n","\n","        if diff > 180:\n","            diff = 360 - diff\n","\n","        return diff\n","\n","\n","    # --------------------------------------------------\n","    # Find vessels near the current vessel\n","    # --------------------------------------------------\n","\n","    def find_neighbors(\n","        self,\n","        frame_df,\n","        current_index\n","    ):\n","\n","        current = frame_df.loc[\n","            current_index\n","        ]\n","\n","        neighbors = []\n","\n","        for idx, vessel in frame_df.iterrows():\n","\n","            if idx == current_index:\n","                continue\n","\n","            try:\n","\n","                distance = self.distance_km(\n","                    float(current[\"latitude\"]),\n","                    float(current[\"longitude\"]),\n","                    float(vessel[\"latitude\"]),\n","                    float(vessel[\"longitude\"])\n","                )\n","\n","            except:\n","\n","                continue\n","\n","            if distance <= self.proximity_km:\n","\n","                bearing = self.bearing(\n","                    float(current[\"latitude\"]),\n","                    float(current[\"longitude\"]),\n","                    float(vessel[\"latitude\"]),\n","                    float(vessel[\"longitude\"])\n","                )\n","\n","                neighbors.append({\n","                    \"index\": idx,\n","                    \"track_id\": vessel.get(\n","                        \"track_id\"\n","                    ),\n","                    \"distance_km\": distance,\n","                    \"bearing_deg\": bearing,\n","                    \"heading_deg\": float(\n","                        vessel.get(\n","                            \"heading_deg\",\n","                            0\n","                        )\n","                    )\n","                })\n","\n","        return neighbors\n","\n","\n","    # --------------------------------------------------\n","    # Analyze the maritime situation\n","    # --------------------------------------------------\n","\n","    def analyze(\n","        self,\n","        frame_df,\n","        current_index\n","    ):\n","\n","        current = frame_df.loc[\n","            current_index\n","        ]\n","\n","        neighbors = self.find_neighbors(\n","            frame_df,\n","            current_index\n","        )\n","\n","        situation = {\n","            \"neighbor_count\": len(neighbors),\n","            \"closest_distance_km\": None,\n","            \"closest_bearing_deg\": None,\n","            \"closest_track_id\": None,\n","            \"risk_score\": 0.0,\n","            \"risk_level\": \"LOW\",\n","            \"reason\": \"No nearby vessel.\"\n","        }\n","\n","        if not neighbors:\n","            return situation\n","\n","        closest = min(\n","            neighbors,\n","            key=lambda x: x[\"distance_km\"]\n","        )\n","\n","        distance = closest[\n","            \"distance_km\"\n","        ]\n","\n","        situation[\n","            \"closest_distance_km\"\n","        ] = round(\n","            distance,\n","            4\n","        )\n","\n","        situation[\n","            \"closest_bearing_deg\"\n","        ] = round(\n","            closest[\"bearing_deg\"],\n","            2\n","        )\n","\n","        situation[\n","            \"closest_track_id\"\n","        ] = closest[\n","            \"track_id\"\n","        ]\n","\n","        # ------------------------------------------\n","        # Distance-based risk\n","        # ------------------------------------------\n","\n","        if distance <= self.critical_distance_km:\n","\n","            risk = 100\n","            level = \"CRITICAL\"\n","\n","        elif distance <= 1.0:\n","\n","            risk = 75\n","            level = \"HIGH\"\n","\n","        elif distance <= 1.5:\n","\n","            risk = 50\n","            level = \"MEDIUM\"\n","\n","        else:\n","\n","            risk = 25\n","            level = \"LOW\"\n","\n","        situation[\n","            \"risk_score\"\n","        ] = risk\n","\n","        situation[\n","            \"risk_level\"\n","        ] = level\n","\n","        situation[\n","            \"reason\"\n","        ] = (\n","            f\"{len(neighbors)} nearby vessel(s); \"\n","            f\"closest vessel is \"\n","            f\"{distance:.3f} km away at bearing \"\n","            f\"{closest['bearing_deg']:.1f} degrees.\"\n","        )\n","\n","        return situation\n","\n","\n","    # --------------------------------------------------\n","    # Recommend action\n","    # --------------------------------------------------\n","\n","    def recommend_action(\n","        self,\n","        situation\n","    ):\n","\n","        risk = situation[\n","            \"risk_score\"\n","        ]\n","\n","        bearing = situation[\n","            \"closest_bearing_deg\"\n","        ]\n","\n","        if bearing is None:\n","\n","            return (\n","                \"MAINTAIN_COURSE\",\n","                \"No nearby vessel detected.\"\n","            )\n","\n","        # ------------------------------------------\n","        # Critical proximity\n","        # ------------------------------------------\n","\n","        if risk >= 100:\n","\n","            return (\n","                \"STOP\",\n","                \"Critical proximity to another vessel.\"\n","            )\n","\n","        # ------------------------------------------\n","        # High risk\n","        # ------------------------------------------\n","\n","        if risk >= 75:\n","\n","            # Vessel is ahead\n","            if 315 <= bearing or bearing <= 45:\n","\n","                return (\n","                    \"SLOW_DOWN\",\n","                    \"High-risk vessel detected ahead.\"\n","                )\n","\n","            # Vessel on right\n","            if 45 < bearing < 180:\n","\n","                return (\n","                    \"TURN_LEFT\",\n","                    \"High-risk vessel detected on starboard side.\"\n","                )\n","\n","            # Vessel on left\n","            if 180 <= bearing < 315:\n","\n","                return (\n","                    \"TURN_RIGHT\",\n","                    \"High-risk vessel detected on port side.\"\n","                )\n","\n","        # ------------------------------------------\n","        # Medium risk\n","        # ------------------------------------------\n","\n","        if risk >= 50:\n","\n","            return (\n","                \"SLOW_DOWN\",\n","                \"Nearby vessel requires increased caution.\"\n","            )\n","\n","        # ------------------------------------------\n","        # Low risk\n","        # ------------------------------------------\n","\n","        return (\n","            \"MAINTAIN_COURSE\",\n","            \"Nearby vessel is outside the immediate risk zone.\"\n","        )\n","\n","\n","    # --------------------------------------------------\n","    # Process complete dataset\n","    # --------------------------------------------------\n","\n","    def process(\n","        self,\n","        input_file,\n","        output_file\n","    ):\n","\n","        df = pd.read_csv(\n","            input_file\n","        )\n","\n","        required = [\n","            \"frame\",\n","            \"track_id\",\n","            \"latitude\",\n","            \"longitude\"\n","        ]\n","\n","        missing = [\n","            c for c in required\n","            if c not in df.columns\n","        ]\n","\n","        if missing:\n","\n","            raise ValueError(\n","                \"Missing columns: \"\n","                + str(missing)\n","            )\n","\n","        results = []\n","\n","        print(\n","            \"Processing frames...\"\n","        )\n","\n","        for frame, frame_df in df.groupby(\n","            \"frame\"\n","        ):\n","\n","            frame_df = frame_df.copy()\n","\n","            for index in frame_df.index:\n","\n","                situation = self.analyze(\n","                    frame_df,\n","                    index\n","                )\n","\n","                action, action_reason = (\n","                    self.recommend_action(\n","                        situation\n","                    )\n","                )\n","\n","                results.append({\n","                    \"frame\": frame,\n","                    \"track_id\":\n","                        frame_df.loc[\n","                            index,\n","                            \"track_id\"\n","                        ],\n","\n","                    \"neighbor_count\":\n","                        situation[\n","                            \"neighbor_count\"\n","                        ],\n","\n","                    \"closest_distance_km\":\n","                        situation[\n","                            \"closest_distance_km\"\n","                        ],\n","\n","                    \"closest_bearing_deg\":\n","                        situation[\n","                            \"closest_bearing_deg\"\n","                        ],\n","\n","                    \"closest_track_id\":\n","                        situation[\n","                            \"closest_track_id\"\n","                        ],\n","\n","                    \"spatial_risk_score\":\n","                        situation[\n","                            \"risk_score\"\n","                        ],\n","\n","                    \"spatial_risk_level\":\n","                        situation[\n","                            \"risk_level\"\n","                        ],\n","\n","                    \"recommended_action\":\n","                        action,\n","\n","                    \"action_reason\":\n","                        action_reason\n","                })\n","\n","        result = pd.DataFrame(\n","            results\n","        )\n","\n","        result.to_csv(\n","            output_file,\n","            index=False\n","        )\n","\n","        print(\n","            \"\\n================================\"\n","        )\n","\n","        print(\n","            \"MULTI-VESSEL REASONING RESULTS\"\n","        )\n","\n","        print(\n","            \"================================\"\n","        )\n","\n","        print(\n","            \"\\nTotal decisions:\",\n","            len(result)\n","        )\n","\n","        print(\n","            \"\\nActions:\"\n","        )\n","\n","        print(\n","            result[\n","                \"recommended_action\"\n","            ].value_counts()\n","        )\n","\n","        print(\n","            \"\\nRisk levels:\"\n","        )\n","\n","        print(\n","            result[\n","                \"spatial_risk_level\"\n","            ].value_counts()\n","        )\n","\n","        print(\n","            \"\\nSaved to:\"\n","        )\n","\n","        print(output_file)\n","\n","        return result"]},{"cell_type":"code","execution_count":null,"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"executionInfo":{"elapsed":2890,"status":"ok","timestamp":1787214930230,"user":{"displayName":"MADHU SHREE T 23ADR099","userId":"11834266471021201390"},"user_tz":-330},"id":"mq1o9ZkFT4pM","outputId":"3c1c8d71-9529-4bc0-b544-050e8b83a423"},"outputs":[{"name":"stdout","output_type":"stream","text":["Multi-vessel reasoning module initialized\n","Processing frames...\n","\n","================================\n","MULTI-VESSEL REASONING RESULTS\n","================================\n","\n","Total decisions: 1529\n","\n","Actions:\n","recommended_action\n","STOP               1499\n","MAINTAIN_COURSE      30\n","Name: count, dtype: int64\n","\n","Risk levels:\n","spatial_risk_level\n","CRITICAL    1499\n","LOW           30\n","Name: count, dtype: int64\n","\n","Saved to:\n","/content/drive/MyDrive/ResearchProject/agentic_ai/outputs/multi_vessel_actions.csv\n"]}],"source":["from multi_vessel_reasoner import MultiVesselReasoner\n","\n","INPUT = (\n","    \"/content/drive/MyDrive/ResearchProject/\"\n","    \"ais/georeferenced_detections.csv\"\n",")\n","\n","OUTPUT = (\n","    \"/content/drive/MyDrive/ResearchProject/\"\n","    \"agentic_ai/outputs/\"\n","    \"multi_vessel_actions.csv\"\n",")\n","\n","agent = MultiVesselReasoner()\n","\n","re