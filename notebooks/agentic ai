ive/ResearchProject/ais/georeferenced_detections.csv\"\n","\n","df = pd.read_csv(FILE)\n","\n","print(\"Columns:\")\n","print(df.columns.tolist())\n","\n","print(\"\\nShape:\")\n","print(df.shape)\n","\n","print(\"\\nFirst 5 rows:\")\n","display(df.head())\n","\n","# Look specifically for timing-related columns\n","time_columns = [\n","    c for c in df.columns\n","    if any(x in c.lower() for x in\n","           [\"time\", \"date\", \"timestamp\", \"fps\", \"second\"])\n","]\n","\n","print(\"\\nPossible time columns:\")\n","print(time_columns)"]},{"cell_type":"code","execution_count":null,"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"executionInfo":{"elapsed":26,"status":"ok","timestamp":1787216065111,"user":{"displayName":"MADHU SHREE T 23ADR099","userId":"11834266471021201390"},"user_tz":-330},"id":"LU-u8jdcXSx7","outputId":"432d0b26-ad61-456c-d027-d319952982c3"},"outputs":[{"name":"stdout","output_type":"stream","text":["Overwriting /content/drive/MyDrive/ResearchProject/agentic_ai/encounter_classifier.py\n"]}],"source":["%%writefile /content/drive/MyDrive/ResearchProject/agentic_ai/encounter_classifier.py\n","\n","import os\n","import math\n","import pandas as pd\n","\n","\n","# ============================================================\n","# FILE PATHS\n","# ============================================================\n","\n","INPUT_FILE = (\n","    \"/content/drive/MyDrive/ResearchProject/ais/\"\n","    \"georeferenced_detections.csv\"\n",")\n","\n","OUTPUT_DIR = (\n","    \"/content/drive/MyDrive/ResearchProject/agentic_ai/\"\n","    \"outputs\"\n",")\n","\n","OUTPUT_FILE = os.path.join(\n","    OUTPUT_DIR,\n","    \"encounter_classification.csv\"\n",")\n","\n","\n","# ============================================================\n","# PARAMETERS\n","# ============================================================\n","\n","# Distances are in kilometers.\n","# These are simulation/research thresholds, not real vessel\n","# navigation-control limits.\n","\n","SAFE_DISTANCE_KM = 0.20\n","MODERATE_DISTANCE_KM = 0.10\n","HIGH_DISTANCE_KM = 0.05\n","CRITICAL_DISTANCE_KM = 0.02\n","\n","# Bearing sectors relative to own vessel heading.\n","#\n","# 0°   = directly ahead\n","# 90°  = starboard/right\n","# 180° = directly behind\n","# 270° = port/left\n","\n","HEAD_ON_BEARING = 30\n","\n","STARBOARD_MIN = 30\n","STARBOARD_MAX = 150\n","\n","PORT_MIN = 210\n","PORT_MAX = 330\n","\n","REAR_MIN = 150\n","REAR_MAX = 210\n","\n","# Heading difference\n","OPPOSITE_HEADING_MIN = 120\n","SIMILAR_HEADING_MAX = 30\n","\n","\n","# ============================================================\n","# GEOGRAPHIC DISTANCE\n","# ============================================================\n","\n","def distance_km(\n","    lat1,\n","    lon1,\n","    lat2,\n","    lon2\n","):\n","\n","    R = 6371.0\n","\n","    lat1 = math.radians(lat1)\n","    lat2 = math.radians(lat2)\n","\n","    dlat = lat2 - lat1\n","    dlon = math.radians(lon2 - lon1)\n","\n","    a = (\n","        math.sin(dlat / 2) ** 2\n","        +\n","        math.cos(lat1)\n","        * math.cos(lat2)\n","        * math.sin(dlon / 2) ** 2\n","    )\n","\n","    return (\n","        2\n","        * R\n","        * math.atan2(\n","            math.sqrt(a),\n","            math.sqrt(1 - a)\n","        )\n","    )\n","\n","\n","# ============================================================\n","# TRUE BEARING FROM OWN VESSEL TO TARGET\n","# ============================================================\n","\n","def calculate_bearing(\n","    lat1,\n","    lon1,\n","    lat2,\n","    lon2\n","):\n","\n","    lat1_rad = math.radians(lat1)\n","    lat2_rad = math.radians(lat2)\n","\n","    dlon = math.radians(\n","        lon2 - lon1\n","    )\n","\n","    x = (\n","        math.sin(dlon)\n","        * math.cos(lat2_rad)\n","    )\n","\n","    y = (\n","        math.cos(lat1_rad)\n","        * math.sin(lat2_rad)\n","        -\n","        math.sin(lat1_rad)\n","        * math.cos(lat2_rad)\n","        * math.cos(dlon)\n","    )\n","\n","    bearing = math.degrees(\n","        math.atan2(x, y)\n","    )\n","\n","    return (bearing + 360) % 360\n","\n","\n","# ============================================================\n","# ANGLE DIFFERENCE\n","# ============================================================\n","\n","def angle_difference(\n","    angle1,\n","    angle2\n","):\n","\n","    diff = abs(\n","        angle1 - angle2\n","    ) % 360\n","\n","    return min(\n","        diff,\n","        360 - diff\n","    )\n","\n","\n","# ============================================================\n","# RELATIVE BEARING\n","# ============================================================\n","\n","def relative_bearing(\n","    own_heading,\n","    target_bearing\n","):\n","\n","    return (\n","        target_bearing\n","        - own_heading\n","    ) % 360\n","\n","\n","# ============================================================\n","# ENCOUNTER CLASSIFICATION\n","# ============================================================\n","\n","def classify_encounter(\n","    own_heading,\n","    target_heading,\n","    rel_bearing\n","):\n","\n","    heading_diff = angle_difference(\n","        own_heading,\n","        target_heading\n","    )\n","\n","    # --------------------------------------------------------\n","    # 1. HEAD-ON\n","    #\n","    # Target approximately ahead and headings are opposite.\n","    # --------------------------------------------------------\n","\n","    if (\n","        rel_bearing <= HEAD_ON_BEARING\n","        or rel_bearing >= 360 - HEAD_ON_BEARING\n","    ):\n","\n","        if heading_diff >= OPPOSITE_HEADING_MIN:\n","\n","            return \"HEAD_ON\"\n","\n","\n","    # --------------------------------------------------------\n","    # 2. OVERTAKING\n","    #\n","    # Similar headings and target is generally behind.\n","    # --------------------------------------------------------\n","\n","    if (\n","        REAR_MIN <= rel_bearing <= REAR_MAX\n","        and heading_diff <= SIMILAR_HEADING_MAX\n","    ):\n","\n","        return \"OVERTAKING\"\n","\n","\n","    # --------------------------------------------------------\n","    # 3. CROSSING STARBOARD\n","    #\n","    # Target is on the right side.\n","    # --------------------------------------------------------\n","\n","    if (\n","        STARBOARD_MIN\n","        < rel_bearing\n","        < STARBOARD_MAX\n","    ):\n","\n","        return \"CROSSING_STARBOARD\"\n","\n","\n","    # --------------------------------------------------------\n","    # 4. CROSSING PORT\n","    #\n","    # Target is on the left side.\n","    # --------------------------------------------------------\n","\n","    if (\n","        PORT_MIN\n","        < rel_bearing\n","        < PORT_MAX\n","    ):\n","\n","        return \"CROSSING_PORT\"\n","\n","\n","    # --------------------------------------------------------\n","    # 5. UNCERTAIN\n","    # --------------------------------------------------------\n","\n","    return \"UNCERTAIN\"\n","\n","\n","# ============================================================\n","# RISK CALCULATION\n","# ============================================================\n","\n","def calculate_risk(\n","    distance,\n","    encounter_type\n","):\n","\n","    # --------------------------------------------------------\n","    # SAFE\n","    # --------------------------------------------------------\n","\n","    if distance > SAFE_DISTANCE_KM:\n","\n","        return (\n","            \"LOW\",\n","            10\n","        )\n","\n","\n","    # --------------------------------------------------------\n","    # MODERATE\n","    # --------------------------------------------------------\n","\n","    if distance > MODERATE_DISTANCE_KM:\n","\n","        return (\n","            \"MODERATE\",\n","            40\n","        )\n","\n","\n","    # --------------------------------------------------------\n","    # HIGH\n","    # --------------------------------------------------------\n","\n","    if distance > HIGH_DISTANCE_KM:\n","\n","        return (\n","            \"HIGH\",\n","            65\n","        )\n","\n","\n","    # --------------------------------------------------------\n","    # CRITICAL\n","    #\n","    # Very close vessels.\n","    # --------------------------------------------------------\n","\n","    if distance <= CRITICAL_DISTANCE_KM:\n","\n","        return (\n","            \"CRITICAL\",\n","            95\n","        )\n","\n","\n","    return (\n","        \"HIGH\",\n","        75\n","    )\n","\n","\n","# ============================================================\n","# ACTION SELECTION\n","# ============================================================\n","\n","def recommend_action(\n","    encounter_type,\n","    risk_level,\n","    relative_bearing\n","):\n","\n","    # --------------------------------------------------------\n","    # LOW RISK\n","    # --------------------------------------------------------\n","\n","    if risk_level == \"LOW\":\n","\n","        return \"MAINTAIN_COURSE\"\n","\n","\n","    # --------------------------------------------------------\n","    # MODERATE RISK\n","    # --------------------------------------------------------\n","\n","    if risk_level == \"MODERATE\":\n","\n","        if encounter_type == \"CROSSING_STARBOARD\":\n","\n","            return \"TURN_LEFT\"\n","\n","        if encounter_type == \"CROSSING_PORT\":\n","\n","            return \"TURN_RIGHT\"\n","\n","        if encounter_type == \"HEAD_ON\":\n","\n","            return \"SLOW_DOWN\"\n","\n","        if encounter_type == \"OVERTAKING\":\n","\n","            return \"SLOW_DOWN\"\n","\n","        return \"SLOW_DOWN\"\n","\n","\n","    # --------------------------------------------------------\n","    # HIGH RISK\n","    # --------------------------------------------------------\n","\n","    if risk_level == \"HIGH\":\n","\n","        if encounter_type == \"HEAD_ON\":\n","\n","            return \"TURN_RIGHT\"\n","\n","        if encounter_type == \"CROSSING_STARBOARD\":\n","\n","            return \"TURN_LEFT\"\n","\n","        if encounter_type == \"CROSSING_PORT\":\n","\n","            return \"TURN_RIGHT\"\n","\n","        if encounter_type == \"OVERTAKING\":\n","\n","            return \"SLOW_DOWN\"\n","\n","        # Uncertain high-risk situation\n","        return \"SLOW_DOWN\"\n","\n","\n","    # --------------------------------------------------------\n","    # CRITICAL RISK\n","    #\n","    # IMPORTANT:\n","    # Critical does NOT automatically mean STOP.\n","    # --------------------------------------------------------\n","\n","    if risk_level == \"CRITICAL\":\n","\n","        if encounter_type == \"HEAD_ON\":\n","\n","            return \"STOP\"\n","\n","        if encounter_type == \"CROSSING_STARBOARD\":\n","\n","            return \"TURN_LEFT\"\n","\n","        if encounter_type == \"CROSSING_PORT\":\n","\n","            return \"TURN_RIGHT\"\n","\n","        if encounter_type == \"OVERTAKING\":\n","\n","            return \"STOP\"\n","\n","        # If geometry is uncertain, stop rather than\n","        # making an arbitrary turn.\n","        return \"STOP\"\n","\n","\n","    return \"SLOW_DOWN\"\n","\n","\n","# ============================================================\n","# PROCESS ONE VESSEL AGAINST ALL OTHER VESSELS\n","# ============================================================\n","\n","def process_frame(\n","    frame_df\n","):\n","\n","    results = []\n","\n","    for own_index, own in frame_df.iterrows():\n","\n","        candidates = []\n","\n","        for target_index, target in frame_df.iterrows():\n","\n","            if own_index == target_index:\n","                continue\n","\n","            # ------------------------------------------------\n","            # Distance\n","            # ------------------------------------------------\n","\n","            distance = distance_km(\n","                own[\"latitude\"],\n","                own[\"longitude\"],\n","                target[\"latitude\"],\n","                target[\"longitude\"]\n","            )\n","\n","            # ------------------------------------------------\n","            # Ignore vessels outside the interaction area.\n","            # ------------------------------------------------\n","\n","            if distance > SAFE_DISTANCE_KM:\n","\n","                continue\n","\n","            # ------------------------------------------------\n","            # Geographic bearing\n","            # ------------------------------------------------\n","\n","            target_bearing = calculate_bearing(\n","                own[\"latitude\"],\n","                own[\"longitude\"],\n","                target[\"latitude\"],\n","                target[\"longitude\"]\n","            )\n","\n","            # ------------------------------------------------\n","            # Bearing relative to own vessel\n","            # ------------------------------------------------\n","\n","            rel_bearing = relative_bearing(\n","                own[\"heading_deg\"],\n","                target_bearing\n","            )\n","\n","            # ------------------------------------------------\n","            # Encounter\n","            # ------------------------------------------------\n","\n","            encounter = classify_encounter(\n","                own[\"heading_deg\"],\n","                target[\"heading_deg\"],\n","                rel_bearing\n","            )\n","\n","            # ------------------------------------------------\n","            # Risk\n","            # ------------------------------------------------\n","\n","            risk_level, risk_score = calculate_risk(\n","                distance,\n","                encounter\n","            )\n","\n","            # ------------------------------------------------\n","            # Action\n","            # ------------------------------------------------\n","\n","            action = recommend_action(\n","                encounter,\n","                risk_level,\n","                rel_bearing\n","            )\n","\n","            candidates.append({\n","\n","                \"track_id\":\n","                    own[\"track_id\"],\n","\n","                \"target_track_id\":\n","                    target[\"track_id\"],\n","\n","                \"distance_km\":\n","                    distance,\n","\n","                \"target_bearing_deg\":\n","                    target_bearing,\n","\n","                \"relative_bearing_deg\":\n","                    rel_bearing,\n","\n","                \"heading_difference_deg\":\n","                    angle_difference(\n","                        own[\"heading_deg\"],\n","                        target[\"heading_deg\"]\n","                    ),\n","\n","                \"encounter_type\":\n","                    encounter,\n","\n","                \"risk_level\":\n","                    risk_level,\n","\n","                \"risk_score\":\n","                    risk_score,\n","\n","                \"recommended_action\":\n","                    action\n","            })\n","\n","\n","        # ====================================================\n","        # NO NEARBY VESSEL\n","        # ====================================================\n","\n","        if not candidates:\n","\n","            results.append({\n","\n","                \"track_id\":\n","                    own[\"track_id\"],\n","\n","                \"target_track_id\":\n","                    None,\n","\n","                \"distance_km\":\n","                    None,\n","\n","                \"target_bearing_deg\":\n","                    None,\n","\n","                \"relative_bearing_deg\":\n","                    None,\n","\n","                \"heading_difference_deg\":\n","                    None,\n","\n","                \"encounter_type\":\n","                    \"SAFE\",\n","\n","                \"risk_level\":\n","                    \"LOW\",\n","\n","                \"risk_score\":\n","                    0,\n","\n","                \"recommended_action\":\n","                    \"MAINTAIN_COURSE\"\n","            })\n","\n","            continue\n","\n","\n","        # ====================================================\n","        # SELECT MOST IMPORTANT TARGET\n","        #\n","        # Risk first, distance second.\n","        # ====================================================\n","\n","        best = sorted(\n","            candidates,\n","            key=lambda x: (\n","                -x[\"risk_score\"],\n","                x[\"distance_km\"]\n","            )\n","        )[0]\n","\n","        results.append(best)\n","\n","\n","    return pd.DataFrame(results)\n","\n","\n","# ============================================================\n","# MAIN\n","# ============================================================\n","\n","print(\"=\" * 60)\n","print(\"ENCOUNTER CLASSIFIER\")\n","print(\"=\" * 60)\n","\n","print(\"\\nLoading:\")\n","\n","print(INPUT_FILE)\n","\n","df = pd.read_csv(\n","    INPUT_FILE\n",")\n","\n","print(\n","    \"\\nTotal detections:\",\n","    len(df)\n",")\n","\n","print(\n","    \"Unique frames:\",\n","    df[\"frame\"].nunique()\n",")\n","\n","print(\n","    \"Unique tracks:\",\n","    df[\"track_id\"].nunique()\n",")\n","\n","\n","# ============================================================\n","# VALIDATION\n","# ============================================================\n","\n","required_columns = [\n","    \"frame\",\n","    \"track_id\",\n","    \"heading_deg\",\n","    \"latitude\",\n","    \"longitude\"\n","]\n","\n","missing_columns = [\n","    col\n","    for col in required_columns\n","    if col not in df.columns\n","]\n","\n","if missing_columns:\n","\n","    raise ValueError(\n","        \"Missing required columns: \"\n","        + str(missing_columns)\n","    )\n","\n","\n","# ============================================================\n","# REMOVE INVALID GEOGRAPHIC VALUES\n","# ============================================================\n","\n","df = df.dropna(\n","    subset=[\n","        \"latitude\",\n","        \"longitude\",\n","        \"heading_deg\"\n","    ]\n",").copy()\n","\n","\n","# ============================================================\n","# PROCESS FRAME BY FRAME\n","# ============================================================\n","\n","all_results = []\n","\n","total_frames = df[\"frame\"].nunique()\n","\n","print(\n","    \"\\nProcessing\",\n","    total_frames,\n","    \"frames...\"\n",")\n","\n","for frame_number, frame_df in df.groupby(\n","    \"frame\"\n","):\n","\n","    frame_result = process_frame(\n","        frame_df\n","    )\n","\n","    frame_result[\"frame\"] = frame_number\n","\n","    all_results.append(\n","        frame_result\n","    )\n","\n","\n","# ============================================================\n","# COMBINE\n","# ============================================================\n","\n","if all_results:\n","\n","    result = pd.concat(\n","        all_results,\n","        ignore_index=True\n","    )\n","\n","else:\n","\n","    result = pd.DataFrame()\n","\n","\n","# ============================================================\n","# SORT\n","# ============================================================\n","\n","if not result.empty:\n","\n","    result = result.sort_values(\n","        [\n","            \"frame\",\n","            \"track_id\"\n","        ]\n","    ).reset_index(\n","        drop=True\n","    )\n","\n","\n","# ============================================================\n","# CREATE OUTPUT DIRECTORY\n","# ============================================================\n","\n","os.makedirs(\n","    OUTPUT_DIR,\n","    exist_ok=True\n",")\n","\n","\n","# ============================================================\n","# SAVE\n","# ============================================================\n","\n","result.to_csv(\n","    OUTPUT_FILE,\n","    index=False\n",")\n","\n","\n","# ============================================================\n","# REPORT\n","# ============================================================\n","\n","print(\"\\n\")\n","print(\"=\" * 60)\n","print(\"ENCOUNTER CLASSIFICATION COMPLETED\")\n","print(\"=\" * 60)\n","\n","print(\n","    \"\\nOutput records:\",\n","    len(result)\n",")\n","\n","\n","if not result.empty:\n","\n","    print(\"\\n\")\n","    print(\"ENCOUNTER DISTRIBUTION\")\n","    print(\"-\" * 40)\n","\n","    print(\n","        result[\n","            \"encounter_type\"\n","        ].value_counts()\n","    )\n","\n","\n","    print(\"\\n\")\n","    print(\"RISK DISTRIBUTION\")\n","    print(\"-\" * 40)\n","\n","    print(\n","        result[\n","            \"risk_level\"\n","        ].value_counts()\n","    )\n","\n","\n","    print(\"\\n\")\n","    print(\"ACTION DISTRIBUTION\")\n","    print(\"-\" * 40)\n","\n","    print(\n","        result[\n","            \"recommended_action\"\n","        ].value_counts()\n","    )\n","\n","\n","    print(\"\\n\")\n","    print(\"ACTION PERCENTAGES\")\n","    print(\"-\" * 40)\n","\n","    print(\n","        (\n","            result[\n","                \"recommended_action\"\n","            ]\n","            .value_counts(\n","                normalize=True\n","            )\n","            * 100\n","        )\n","        .round(2)\n","    )\n","\n","\n","    print(\"\\n\")\n","    print(\"CRITICAL SITUATIONS\")\n","    print(\"-\" * 40)\n","\n","    critical = result[\n","        result[\"risk_level\"]\n","        == \"CRITICAL\"\n","    ]\n","\n","    if len(critical) > 0:\n","\n","        print(\n","            critical[\n","                [\n","                    \"frame\",\n","                    \"track_id\",\n","                    \"target_track_id\",\n","                    \"distance_km\",\n","        