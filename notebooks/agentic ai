-----\n","        # Fallback\n","        # -----------------------------------------\n","\n","        return {\n","            \"navigation_action\":\n","                \"MONITOR\",\n","\n","            \"navigation_priority\":\n","                \"LOW\",\n","\n","            \"navigation_reason\":\n","                \"Situation requires continued observation.\"\n","        }\n","\n","\n","    def process(\n","        self,\n","        input_file,\n","        output_file\n","    ):\n","\n","        print(\"\\nLoading Agentic AI decisions...\")\n","\n","        df = pd.read_csv(input_file)\n","\n","        print(\n","            \"Total records:\",\n","            len(df)\n","        )\n","\n","        results = []\n","\n","        for _, row in df.iterrows():\n","\n","            result = self.decide(row)\n","\n","            results.append(result)\n","\n","        navigation_df = pd.DataFrame(\n","            results\n","        )\n","\n","        # Add navigation results to original data\n","        output = pd.concat(\n","            [\n","                df.reset_index(drop=True),\n","                navigation_df\n","            ],\n","            axis=1\n","        )\n","\n","        os.makedirs(\n","            os.path.dirname(output_file),\n","            exist_ok=True\n","        )\n","\n","        output.to_csv(\n","            output_file,\n","            index=False\n","        )\n","\n","        # -----------------------------------------\n","        # Results\n","        # -----------------------------------------\n","\n","        print(\"\\n====================================\")\n","        print(\"NAVIGATION DECISION RESULTS\")\n","        print(\"====================================\")\n","\n","        print(\n","            \"\\nNavigation actions:\"\n","        )\n","\n","        print(\n","            output[\n","                \"navigation_action\"\n","            ].value_counts()\n","        )\n","\n","        print(\n","            \"\\nNavigation priorities:\"\n","        )\n","\n","        print(\n","            output[\n","                \"navigation_priority\"\n","            ].value_counts()\n","        )\n","\n","        print(\n","            \"\\nOutput saved to:\"\n","        )\n","\n","        print(output_file)\n","\n","        return output\n","\n","\n","# ==================================================\n","# CONFIGURATION\n","# ==================================================\n","\n","INPUT_FILE = (\n","    \"/content/drive/MyDrive/ResearchProject/\"\n","    \"agentic_ai/outputs/agent_decisions.csv\"\n",")\n","\n","OUTPUT_FILE = (\n","    \"/content/drive/MyDrive/ResearchProject/\"\n","    \"agentic_ai/outputs/navigation_decisions.csv\"\n",")\n","\n","\n","# ==================================================\n","# RUN\n","# ==================================================\n","\n","if __name__ == \"__main__\":\n","\n","    navigator = NavigationDecision()\n","\n","    result = navigator.process(\n","        INPUT_FILE,\n","        OUTPUT_FILE\n","    )\n","\n","    print(\"\\nSample navigation decisions:\")\n","\n","    columns = [\n","        \"track_id\",\n","        \"MMSI\",\n","        \"intrusion_type\",\n","        \"severity\",\n","        \"decision\",\n","        \"navigation_action\",\n","        \"navigation_priority\",\n","        \"navigation_reason\"\n","    ]\n","\n","    columns = [\n","        c\n","        for c in columns\n","        if c in result.columns\n","    ]\n","\n","    print(\n","        result[columns].head(15)\n","        .to_string(index=False)\n","    )"]},{"cell_type":"code","execution_count":null,"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"executionInfo":{"elapsed":515,"status":"ok","timestamp":1787214569650,"user":{"displayName":"MADHU SHREE T 23ADR099","userId":"11834266471021201390"},"user_tz":-330},"id":"l6_dD6JRShPg","outputId":"7718cdf2-08aa-4db3-9770-ef62f9c39b96"},"outputs":[{"name":"stdout","output_type":"stream","text"