y to another vessel.\n","    13         7               4               0.0234                 6.18           CRITICAL               STOP Critical proximity to another vessel.\n","    13        15               4               0.0132               191.36           CRITICAL               STOP Critical proximity to another vessel.\n","    13        17               4               0.0017               179.82           CRITICAL               STOP Critical proximity to another vessel.\n","    14        12               2               0.0110                94.66           CRITICAL               STOP Critical proximity to another vessel.\n","    14        14               2               0.1283               290.19           CRITICAL               STOP Critical proximity to another vessel.\n","    14        15               2               0.0110               274.66           CRITICAL               STOP Critical proximity to another vessel.\n","    15         1               4               0.0205               322.32           CRITICAL               STOP Critical proximity to another vessel.\n","    15         3               4               0.0205               142.32           CRITICAL               STOP Critical proximity to another vessel.\n"]}],"source":["import pandas as pd\n","\n","df = pd.read_csv(\n","    \"/content/drive/MyDrive/ResearchProject/\"\n","    \"agentic_ai/outputs/multi_vessel_actions.csv\"\n",")\n","\n","print(\n","    df[\n","        [\n","            \"frame\",\n","            \"track_id\",\n","            \"neighbor_count\",\n","            \"closest_distance_km\",\n","            \"closest_bearing_deg\",\n","            \"spatial_risk_level\",\n","            \"recommended_action\",\n","            \"action_reason\"\n","        ]\n","    ].head(30).to_string(index=False)\n",")"]},{"cell_type":"code","execution_count":null,"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"executionInfo":{"elapsed":56,"status":"ok","timestamp":1787215167766,"user":{"displayName":"MADHU SHREE T 23ADR099","userId":"11834266471021201390"},"user_tz":-330},"id":"MvMhuAYPUzTk","outputId":"4cfb2369-0736-40b7-a766-3cef1188b122"},"outputs":[{"name":"stdout","output_type":"stream","text":["Writing /content/drive/MyDrive/ResearchProject/agentic_ai/cpa_tcpa.py\n"]}],"source":["%%writefile /content/drive/MyDrive/ResearchProject/agentic_ai/cpa_tcpa.py\n","\n","import math\n","import pandas as pd\n","\n","\n","class CPATCPAAnalyzer:\n","\n","    def __init__(self, neighbor_radius_km=2.0):\n","        self.neighbor_radius_km = neighbor_radius_km\n","\n","        print(\"CPA/TCPA analyzer initialized\")\n","\n","\n","    # =========================================================\n","    # Geographic distance\n","    # =========================================================\n","\n","    def distance_km(self, lat1, lon1, lat2, lon2):\n","\n","        R = 6371.0\n","\n","        lat1 = math.radians(lat1)\n","        lat2 = math.radians(lat2)\n","\n","        dlat = math.radians(lat2 - lat1)\n","        dlon = math.radians(lon2 - lon1)\n","\n","        a = (\n","            math.sin(dlat / 2) ** 2\n","            +\n","            math.cos(lat1)\n","            * math.cos(lat2)\n","            * math.sin(dlon / 2) ** 2\n","        )\n","\n","        return (\n","            2\n","            * R\n","            * math.atan2(\n","                math.sqrt(a),\n","                math.sqrt(1 - a)\n","            )\n","        )\n","\n","\n","    # =========================================================\n","    # Convert speed + heading to east/north velocity\n","    #\n","    # SOG assumed to be knots\n","    # =========================================================\n","\n","    def velocity_components(self, speed_knots, heading_deg):\n","\n","        # knots → km/hour\n","        speed_kmh = speed_knots * 1.852\n","\n","        heading = math.radians(\n","            heading_deg\n","        )\n","\n","        # Heading 0 = north\n","        north = (\n","            speed_kmh\n","            * math.cos(heading)\n","        )\n","\n","        east = (\n","            speed_kmh\n","            * math.sin(heading)\n","        )\n","\n","        return east, north\n","\n","\n","    # =========================================================\n","    # Approximate local x/y coordinates\n","    # x = east-west km\n","    # y = north-south km\n","    # =========================================================\n","\n","    def local_coordinates(\n","        self,\n","        lat,\n","        lon,\n","        ref_lat,\n","        ref_lon\n","    ):\n","\n","        lat_scale = 111.32\n","\n","        lon_scale = (\n","            111.32\n","            * math.cos(\n","                math.radians(ref_lat)\n","            )\n","        )\n","\n","        x = (\n","            lon - ref_lon\n","        ) * lon_scale\n","\n","        y = (\n","            lat - ref_lat\n","        ) * lat_scale\n","\n","        return x, y\n","\n","\n","    # =========================================================\n","    # CPA / TCPA\n","    #\n","    # Returns:\n","    # CPA distance in km\n","    # TCPA in hours\n","    # =========================================================\n","\n","    def calculate_cpa_tcpa(\n","        self,\n","        own,\n","        target\n","    ):\n","\n","        ref_lat = own[\"latitude\"]\n","        ref_lon = own[\"longitude\"]\n","\n","        x1, y1 = self.local_coordinates(\n","            own[\"latitude\"],\n","            own[\"longitude\"],\n","            ref_lat,\n","            ref_lon\n","        )\n","\n","        x2, y2 = self.local_coordinates(\n","            target[\"latitude\"],\n","            target[\"longitude\"],\n","            ref_lat,\n","            ref_lon\n","        )\n","\n","        rx = x2 - x1\n","        ry = y2 - y1\n","\n","        own_east, own_north = (\n","            self.velocity_components(\n","                own[\"speed\"],\n","                own[\"heading\"]\n","            )\n","        )\n","\n","        target_east, target_north = (\n","            self.velocity_components(\n","                target[\"speed\"],\n","                target[\"heading\"]\n","            )\n","        )\n","\n","        rvx = (\n","            target_east\n","            - own_east\n","        )\n","\n","        rvy = (\n","            target_north\n","            - own_north\n","        )\n","\n","        relative_speed_sq = (\n","            rvx ** 2\n","            +\n","            rvy ** 2\n","        )\n","\n","        relative_position_sq = (\n","            rx ** 2\n","            +\n","            ry ** 2\n","        )\n","\n","        # Already stationary relative to each other\n","        if relative_speed_sq < 1e-8:\n","\n","            cpa = math.sqrt(\n","                relative_position_sq\n","            )\n","\n","            return cpa, 0.0\n","\n","\n","        # Time to closest approach\n","        tcpa = -(\n","            rx * rvx\n","            +\n","            ry * rvy\n","        ) / relative_speed_sq\n","\n","        # Negative TCPA means vessels are\n","        # moving away from each other.\n","        if tcpa < 0:\n","\n","            tcpa = 0.0\n","\n","        cpa_x = (\n","            rx\n","            +\n","            rvx * tcpa\n","        )\n","\n","        cpa_y = (\n","            ry\n","            +\n","            rvy * tcpa\n","        )\n","\n","        cpa = math.sqrt(\n","            cpa_x ** 2\n","            +\n","            cpa_y ** 2\n","        )\n","\n","        return cpa, tcpa\n","\n","\n","    # =========================================================\n","    # Risk classification\n","    # =========================================================\n","\n","    def classify_risk(\n","        self,\n","        cpa_km,\n","        tcpa_hours\n","    ):\n","\n","        tcpa_minutes = (\n","            tcpa_hours * 60\n","        )\n","\n","        # Critical:\n","        # very close predicted encounter\n","        # within short time.\n","\n","        if (\n","            cpa_km <= 0.05\n","            and tcpa_minutes <= 5\n","        ):\n","\n","            return (\n","                \"CRITICAL\",\n","                100\n","            )\n","\n","        # High\n","\n","        if (\n","            cpa_km <= 0.10\n","            and tcpa_minutes <= 10\n","        ):\n","\n","            return (\n","                \"HIGH\",\n","                80\n","            )\n","\n","        # Moderate\n","\n","        if (\n","            cpa_km <= 0.25\n","            and tcpa_minutes <= 20\n","        ):\n","\n","            return (\n","                \"MODERATE\",\n","                55\n","            )\n","\n","        # Low\n","\n","        if (\n","            cpa_km <= 0.50\n","            and tcpa_minutes <= 30\n","        ):\n","\n","            return (\n","                \"LOW\",\n","                30\n","            )\n","\n","        return (\n","            \"SAFE\",\n","            0\n","        )\n","\n","\n","    # =========================================================\n","    # Find nearest vessels in same frame\n","    # =========================================================\n","\n","    def analyze_frame(\n","        self,\n","        frame_df\n","    ):\n","\n","        results = []\n","\n","        for own_index, own_row in frame_df.iterrows():\n","\n","            best = None\n","\n","            for target_index, target_row in frame_df.iterrows():\n","\n","                if own_index == target_index:\n","                    continue\n","\n","                try:\n","\n","                    own = {\n","                        \"latitude\":\n","                            float(own_row[\"latitude\"]),\n","\n","                        \"longitude\":\n","                            float(own_row[\"longitude\"]),\n","\n","                        \"speed\":\n","                            float(\n","                                own_row.get(\n","                                    \"speed\",\n","                                    own_row.get(\n","                                        \"SOG\",\n","                                        0\n","                                    )\n","                                )\n","                            ),\n","\n","                        \"heading\":\n","                            float(\n","                                own_row.get(\n","                                    \"heading_deg\",\n","                                    0\n","                                )\n","                            )\n","                    }\n","\n","                    target = {\n","                        \"latitude\":\n","                            float(\n","                                target_row[\n","                                    \"latitude\"\n","                                ]\n","                            ),\n","\n","                        \"longitude\":\n","                            float(\n","                                target_row[\n","                                    \"longitude\"\n","                                ]\n","                            ),\n","\n","                        \"speed\":\n","                            float(\n","                                target_row.get(\n","                                    \"speed\",\n","                                    target_row.get(\n","                                        \"SOG\",\n","                                        0\n","                                    )\n","                                )\n","                            ),\n","\n","                        \"heading\":\n","                            float(\n","                                target_row.get(\n","                                    \"heading_deg\",\n","                                    0\n","                                )\n","                            )\n","                    }\n","\n","                except Exception:\n","                    continue\n","\n","\n","                distance = self.distance_km(\n","                    own[\"latitude\"],\n","                    own[\"longitude\"],\n","                    target[\"latitude\"],\n","                    target[\"longitude\"]\n","                )\n","\n","                if (\n","                    distance\n","                    > self.neighbor_radius_km\n","                ):\n","                    continue\n","\n","\n","                cpa, tcpa = (\n","                    self.calculate_cpa_tcpa(\n","                        own,\n","                        target\n","                    )\n","                )\n","\n","                risk_level, risk_score = (\n","                    self.classify_risk(\n","                        cpa,\n","                        tcpa\n","                    )\n","                )\n","\n","                candidate = {\n","                    \"target_track_id\":\n","                        target_row.get(\n","                            \"track_id\"\n","                        ),\n","\n","                    \"current_distance_km\":\n","                        distance,\n","\n","                    \"cpa_km\":\n","                        cpa,\n","\n","                    \"tcpa_minutes\":\n","                        tcpa * 60,\n","\n","                    \"risk_level\":\n","                        risk_level,\n","\n","                    \"risk_score\":\n","                        risk_score\n","                }\n","\n","                if (\n","                    best is None\n","                    or candidate[\"risk_score\"]\n","                    > best[\"risk_score\"]\n","                ):\n","\n","                    best = candidate\n","\n","\n","            # No nearby vessel\n","\n","            if best is None:\n","\n","                results.append({\n","\n","                    \"track_id\":\n","                        own_row.get(\n","                            \"track_id\"\n","                        ),\n","\n","                    \"target_track_id\":\n","                        None,\n","\n","                    \"current_distance_km\":\n","                        None,\n","\n","                    \"cpa_km\":\n","                        None,\n","\n","                    \"tcpa_minutes\":\n","                        None,\n","\n","                    \"risk_level\":\n","                        \"SAFE\",\n","\n","                    \"risk_score\":\n","                        0\n","\n","                })\n","\n","            else:\n","\n","                result = {\n","                    \"track_id\":\n","                        own_row.get(\n","                            \"track_id\"\n","                        )\n","                }\n","\n","                result.update(best)\n","\n","                results.append(\n","                    result\n","                )\n","\n","        return pd.DataFrame(\n","            results\n","        )\n","\n","\n","    # =========================================================\n","    # Process dataset\n","    # =========================================================\n","\n","    def process(\n","        self,\n","        input_file,\n","        output_file\n","    ):\n","\n","        df = pd.read_csv(\n","            input_file\n","        )\n","\n","        print(\n","            \"Input records:\",\n","            len(df)\n","        )\n","\n","        all_results = []\n","\n","        for frame, frame_df in df.groupby(\n","            \"frame\"\n","        ):\n","\n","            frame_result = self.analyze_frame(\n","                frame_df\n","            )\n","\n","            frame_result[\"frame\"] = frame\n","\n","            all_results.append(\n","                frame_result\n","            )\n","\n","        result = pd.concat(\n","            all_results