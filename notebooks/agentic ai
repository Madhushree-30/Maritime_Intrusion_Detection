=========\n"]}]},{"cell_type":"code","source":["%%writefile /content/drive/MyDrive/ResearchProject/agentic_ai/agent.py\n","\n","import os\n","import pandas as pd\n","\n","\n","class MaritimeAgent:\n","    \"\"\"\n","    Agentic AI controller for maritime surveillance.\n","\n","    Pipeline:\n","        OBSERVE\n","            ↓\n","        ASSESS\n","            ↓\n","        REASON\n","            ↓\n","        CLASSIFY\n","            ↓\n","        DECIDE\n","\n","    IMPORTANT:\n","        The frame column is preserved from intrusion_results.csv\n","        so that Agent Decisions can later be correctly joined\n","        with Encounter Classification using:\n","\n","            frame + track_id\n","    \"\"\"\n","\n","    def __init__(self, intrusion_zone_file):\n","\n","        self.zones = pd.read_csv(\n","            intrusion_zone_file\n","        )\n","\n","        print(\"Maritime Agent initialized\")\n","        print(\n","            f\"Surveillance zones: {len(self.zones)}\"\n","        )\n","\n","    # =====================================================\n","    # OBSERVE\n","    # =====================================================\n","\n","    def observe(self, row):\n","\n","        return {\n","            \"frame\": row.get(\n","                \"frame\",\n","                None\n","            ),\n","\n","            \"track_id\": row.get(\n","                \"track_id\",\n","                None\n","            ),\n","\n","            \"MMSI\": row.get(\n","                \"MMSI\",\n","                None\n","            ),\n","\n","            \"latitude\": row.get(\n","                \"latitude\",\n","                None\n","            ),\n","\n","            \"longitude\": row.get(\n","                \"longitude\",\n","                None\n","            ),\n","\n","            \"speed\": row.get(\n","                \"Speed\",\n","                row.get(\n","                    \"SOG\",\n","                    None\n","                )\n","            ),\n","\n","            \"heading\": row.get(\n","                \"heading_deg\",\n","                row.get(\n","                    \"Heading\",\n","                    None\n","                )\n","            ),\n","\n","            \"ais_match\": row.get(\n","                \"ais_match\",\n","                False\n","            ),\n","\n","            \"match_quality\": row.get(\n","                \"match_quality\",\n","                \"unmatched\"\n","            ),\n","\n","            \"distance_to_ais_km\": row.get(\n","                \"distance_to_ais_km\",\n","                None\n","            ),\n","\n","            \"intrusion_status\": row.get(\n","                \"intrusion_status\",\n","                \"NORMAL\"\n","            ),\n","\n","            \"intrusion_zone\": row.get(\n","                \"intrusion_zone\",\n","                None\n","            )\n","        }\n","\n","    # =====================================================\n","    # ASSESS\n","    # =====================================================\n","\n","    def assess(self, observation):\n","\n","        assessment = {}\n","\n","        # -------------------------------------------------\n","        # AIS STATE\n","        # -------------------------------------------------\n","\n","        if bool(observation[\"ais_match\"]):\n","\n","            assessment[\"ais_state\"] = (\n","                \"IDENTIFIED\"\n","            )\n","\n","        else:\n","\n","            assessment[\"ais_state\"] = (\n","                \"UNKNOWN\"\n","            )\n","\n","        # -------------------------------------------------\n","        # IDENTITY CONFIDENCE\n","        # -------------------------------------------------\n","\n","        quality = str(\n","            observation[\"match_quality\"]\n","        ).lower()\n","\n","        if quality == \"reliable\":\n","\n","            assessment[\n","                \"identity_confidence\"\n","            ] = \"HIGH\"\n","\n","        elif quality == \"moderate\":\n","\n","            assessment[\n","                \"identity_confidence\"\n","            ] = \"MEDIUM\"\n","\n","        else:\n","\n","            assessment[\n","                \"identity_confidence\"\n","            ] = \"LOW\"\n","\n","        # -------------------------------------------------\n","        # ZONE STATE\n","        # -------------------------------------------------\n","\n","        status = observation[\n","            \"intrusion_status\"\n","        ]\n","\n","        if status == \"INTRUSION\":\n","\n","            assessment[\n","                \"zone_state\"\n","            ] = \"INSIDE\"\n","\n","        else:\n","\n","            assessment[\n","                \"zone_state\"\n","            ] = \"OUTSIDE\"\n","\n","        return assessment\n","\n","    # =====================================================\n","    # REASON\n","    # =====================================================\n","\n","    def reason(\n","        self,\n","        observation,\n","        assessment\n","    ):\n","\n","        intrusion_status = observation[\n","            \"intrusion_status\"\n","        ]\n","\n","        ais_state = assessment[\n","            \"ais_state\"\n","        ]\n","\n","        # -------------------------------------------------\n","        # UNKNOWN AIS\n","        # -------------------------------------------------\n","\n","        if ais_state == \"UNKNOWN\":\n","\n","            return {\n","                \"intrusion\": False,\n","                \"intrusion_type\":\n","                    \"AIS_UNIDENTIFIED\",\n","                \"severity\":\n","                    \"MEDIUM\",\n","                \"reason\":\n","                    \"Vessel detected without \"\n","                    \"a reliable AIS association.\"\n","            }\n","\n","        # -------------------------------------------------\n","        # CONFIRMED INTRUSION\n","        # -------------------------------------------------\n","\n","        if intrusion_status == \"INTRUSION\":\n","\n","            return {\n","                \"intrusion\": True,\n","                \"intrusion_type\":\n","                    \"UNAUTHORIZED_ENTRY\",\n","                \"severity\":\n","                    \"HIGH\",\n","                \"reason\":\n","                    \"Identified vessel has entered \"\n","                    \"the surveillance zone.\"\n","            }\n","\n","        # -------------------------------------------------\n","        # NORMAL\n","        # -------------------------------------------------\n","\n","        return {\n","            \"intrusion\": False,\n","            \"intrusion_type\":\n","                \"NORMAL\",\n","            \"severity\":\n","                \"NONE\",\n","            \"reason\":\n","                \"No intrusion condition detected.\"\n","        }\n","\n","    # =====================================================\n","    # DECIDE\n","    # =====================================================\n","\n","    def decide(self, reasoning):\n","\n","        intrusion_type = reasoning[\n","            \"intrusion_type\"\n","        ]\n","\n","        severity = reasoning[\n","            \"severity\"\n","        ]\n","\n","        # -------------------------------------------------\n","        # UNAUTHORIZED ENTRY\n","        # -------------------------------------------------\n","\n","        if intrusion_type == (\n","            \"UNAUTHORIZED_ENTRY\"\n","        ):\n","\n","            return {\n","                \"decision\":\n","                    \"ALERT\",\n","\n","                \"action\":\n","                    \"ALERT_AND_MONITOR\"\n","            }\n","\n","        # -------------------------------------------------\n","        # UNKNOWN AIS\n","        # -------------------------------------------------\n","\n","        if intrusion_type == (\n","            \"AIS_UNIDENTIFIED\"\n","        ):\n","\n","            return {\n","                \"decision\":\n","                    \"MONITOR\",\n","\n","                \"action\":\n","                    \"CONTINUE_OBSERVATION\"\n","            }\n","\n","        # -------------------------------------------------\n","        # NORMAL\n","        # -------------------------------------------------\n","\n","        return {\n","            \"decision\":\n","                \"NORMAL\",\n","\n","            \"action\":\n","                \"NO_ACTION\"\n","        }\n","\n","    # =====================================================\n","    # PROCESS\n","    # =====================================================\n","\n","    def process(\n","        self,\n","        input_file,\n","        output_file\n","    ):\n","\n","        print(\n","            \"\\nLoading surveillance observations...\"\n","        )\n","\n","        df = pd.read_csv(\n","            input_file\n","        )\n","\n","        print(\n","            \"Input records:\",\n","            len(df)\n","        )\n","\n","        # =================================================\n","        # REQUIRED COLUMNS\n","        # =================================================\n","\n","        required = [\n","            \"frame\",\n","            \"track_id\",\n","            \"latitude\",\n","            \"longitude\",\n","            \"ais_match\",\n","            \"match_quality\",\n","            \"intrusion_status\"\n","        ]\n","\n","        missing = [\n","            c\n","            for c in required\n","            if c not in df.columns\n","        ]\n","\n","        if missing:\n","\n","            raise ValueError(\n","                \"Missing required columns: \"\n","                + str(missing)\n","            )\n","\n","        # =================================================\n","        # MAKE SURE FRAME IS NUMERIC\n","        # =================================================\n","\n","        df[\"frame\"] = pd.to_numeric(\n","            df[\"frame\"],\n","            errors=\"coerce\"\n","        )\n","\n","        # =================================================\n","        # PROCESS EACH OBSERVATION\n","        # =================================================\n","\n","        results = []\n","\n","        for _, row in df.iterrows():\n","\n","            observation = self.observe(\n","                row\n","            )\n","\n","            assessment = self.assess(\n","                observation\n","            )\n","\n","            reasoning = self.reason(\n","                observation,\n","                assessment\n","            )\n","\n","            decision = self.decide(\n","                reasoning\n","            )\n","\n","            result = {\n","\n","                # -----------------------------------------\n","                # KEY IDENTIFIERS\n","                # -----------------------------------------\n","\n","                \"frame\":\n","                    observation[\"frame\"],\n","\n","                \"track_id\":\n","                    observation[\"track_id\"],\n","\n","                \"MMSI\":\n","                    observation[\"MMSI\"],\n","\n","                # -----------------------------------------\n","                # POSITION\n","                # -----------------------------------------\n","\n","                \"latitude\":\n","                    observation[\"latitude\"],\n","\n","                \"longitude\":\n","                    observation[\"longitude\"],\n","\n","                # -----------------------------------------\n","                # MOTION\n","                # -----------------------------------------\n","\n","                \"speed\":\n","                    observation[\"speed\"],\n","\n","                \"heading\":\n","                    observation[\"heading\"],\n","\n","                # -----------------------------------------\n","                # AIS\n","                # -----------------------------------------\n","\n","                \"ais_match\":\n","                    observation[\"ais_match\"],\n","\n","                \"match_quality\":\n","                    observation[\"match_quality\"],\n","\n","                \"distance_to_ais_km\":\n","                    observation[\n","                        \"distance_to_ais_km\"\n","                    ],\n","\n","                # -----------------------------------------\n","                # INTRUSION\n","                # -----------------------------------------\n","\n","                \"intrusion_status\":\n","                    observation[\n","                        \"intrusion_status\"\n","                    ],\n","\n","                \"intrusion_zone\":\n","                    observation[\n","                        \"intrusion_zone\"\n","                    ],\n","\n","                # -----------------------------------------\n","                # ASSESSMENT\n","                # -----------------------------------------\n","\n","                \"ais_state\":\n","                    assessment[\n","                        \"ais_state\"\n","                    ],\n","\n","                \"identity_confidence\":\n","                    assessment[\n","                        \"identity_confidence\"\n","                    ],\n","\n","                \"zone_state\":\n","                    assessment[\n","                        \"zone_state\"\n","                    ],\n","\n","                # -----------------------------------------\n","                # REASONING\n","                # -----------------------------------------\n","\n","                \"intrusion\":\n","                    reasoning[\n","                        \"intrusion\"\n","                    ],\n","\n","                \"intrusion_type\":\n","                    reasoning[\n","                        \"intrusion_type\"\n","                    ],\n","\n","                \"severity\":\n","                    reasoning[\n","                        \"severity\"\n","                    ],\n","\n","                \"reason\":\n","                    reasoning[\n","                        \"reason\"\n","                    ],\n","\n","                # -----------------------------------------\n","                # DECISION\n","                # -----------------------------------------\n","\n","                \"decision\":\n","                    decision[\n","                        \"decision\"\n","                    ],\n","\n","                \"action\":\n","                    decision[\n","                        \"action\"\n","                    ]\n","            }\n","\n","            results.append(\n","                result\n","            )\n","\n","        result_df = pd.DataFrame(\n","            results\n","        )\n","\n","        # =================================================\n","        # SAFETY CHECK\n","        # =================================================\n","\n","        if len(result_df) != len(df):\n","\n","            raise RuntimeError(\n","                \"Agent output row count changed. \"\n","                f\"Input={len(df)}, \"\n","                f\"Output={len(result_df)}\"\n","            )\n","\n","        # =================================================\n","        # FRAME VALIDATION\n","        # =================================================\n","\n","        frame_count = (\n","            result_df[\"frame\"]\n","            .notna()\n","            .sum()\n","        )\n","\n","        print(\n","            \"\\nFrame preservation:\"\n","        )\n","\n","        print(\n","            \"Rows with frame:\",\n","            frame_count\n","        )\n","\n","        print(\n","            \"Rows without frame:\",\n","            len(result_df) - frame_count\n","        )\n","\n","        print(\n","            \"Unique frames:\",\n","            result_df[\"frame\"]\n","            .nunique()\n","        )\n","\n","        print(\n","            \"Unique tracks:\",\n","            result_df[\"track_id\"]\n","            .nunique()\n","        )\n","\n","        # =================================================\n","        # DUPLICATE CHECK\n","        # =================================================\n","\n","        valid_keys = result_df[\n","            [\"frame\", \"track_id\"]\n","        ].dropna()\n","\n","        duplicate_count = (\n","            valid_keys.duplicated(\n","                subset=[\n","                    \"frame\",\n","                    \"track_id\"\n","                ],\n","                keep=False\n","            ).sum()\n","        )\n","\n","        print(\n","            \"\\nDuplicate (frame, track_id) rows:\",\n","            duplicate_count\n","        )\n","\n","        # =================================================\n","        # SAVE\n","        # =================================================\n","\n","        os.makedirs(\n","            os.path.dirname(\n","                output_file\n","            ),\n","            exist_ok=True\n","        )\n","\n","        result_df.to_csv(\n","            output_file,\n","            index=False\n","        )\n","\n","        # =================================================\n","        # RESULTS\n","        # =================================================\n","\n","        print(\n","            \"\\n======================================\"\n","        )\n","\n","        print(\n","            \"AGENTIC AI RESULTS\"\n","        )\n","\n","        print(\n","            \"======================================\"\n","        )\n","\n","        print(\n","            \"Total observations:\",\n","            len(result_df)\n","        )\n","\n","        print(\n","            \"\\nIntrusion distribution:\"\n","        )\n","\n","        print(\n","            result_df[\n","                \"intrusion\"\n","            ]