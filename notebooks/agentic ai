========================================\n","# PROJECT PATHS\n","# ============================================================\n","\n","PROJECT_ROOT = Path(\n","    \"/content/drive/MyDrive/ResearchProject\"\n",")\n","\n","AIS_DIR = PROJECT_ROOT / \"ais\"\n","\n","AGENTIC_DIR = PROJECT_ROOT / \"agentic_ai\"\n","\n","OUTPUT_DIR = AGENTIC_DIR / \"outputs\"\n","\n","MODELS_DIR = PROJECT_ROOT / \"models\"\n","\n","\n","# ============================================================\n","# MODEL PATHS\n","# ============================================================\n","\n","VISUAL_MODEL = (\n","    MODELS_DIR\n","    / \"seedrones\"\n","    / \"best_seedrones_detector.pt\"\n",")\n","\n","RADAR_MODEL = (\n","    MODELS_DIR\n","    / \"best_model\"\n","    / \"best_ship_detector.pt\"\n",")\n","\n","\n","# ============================================================\n","# OTHER FILES\n","# ============================================================\n","\n","TILE_BOUNDS = (\n","    AIS_DIR\n","    / \"tile_bounds_los_angeles.csv\"\n",")\n","\n","\n","# ============================================================\n","# OUTPUT FILES\n","# ============================================================\n","\n","SINGLE_IMAGE_DETECTIONS = (\n","    OUTPUT_DIR\n","    / \"single_image_detections.csv\"\n",")\n","\n","SINGLE_IMAGE_TRACKS = (\n","    OUTPUT_DIR\n","    / \"single_image_tracks.csv\"\n",")\n","\n","SINGLE_IMAGE_GEO = (\n","    OUTPUT_DIR\n","    / \"single_image_georeferenced.csv\"\n",")\n","\n","SINGLE_IMAGE_DECISION = (\n","    OUTPUT_DIR\n","    / \"single_image_agent_decision.csv\"\n",")\n","\n","FUSION_OUTPUT = (\n","    AIS_DIR\n","    / \"single_image_fusion_output.csv\"\n",")\n","\n","\n","# ============================================================\n","# CREATE OUTPUT DIRECTORY\n","# ============================================================\n","\n","OUTPUT_DIR.mkdir(\n","    parents=True,\n","    exist_ok=True\n",")\n","\n","\n","# ============================================================\n","# MODULE LOADER\n","# ============================================================\n","\n","def import_module_from_file(\n","    module_name,\n","    file_path\n","):\n","    \"\"\"\n","    Import one of the existing project modules.\n","    \"\"\"\n","\n","    import importlib.util\n","\n","    file_path = Path(file_path)\n","\n","    if not file_path.exists():\n","\n","        raise FileNotFoundError(\n","            f\"Module not found:\\n{file_path}\"\n","        )\n","\n","    spec = (\n","        importlib.util\n","        .spec_from_file_location(\n","            module_name,\n","            str(file_path)\n","        )\n","    )\n","\n","    if spec is None:\n","        raise ImportError(\n","            f\"Could not create module spec for:\\n{file_path}\"\n","        )\n","\n","    if spec.loader is None:\n","        raise ImportError(\n","            f\"Could not load module:\\n{file_path}\"\n","        )\n","\n","    module = (\n","        importlib.util\n","        .module_from_spec(spec)\n","    )\n","\n","    sys.modules[module_name] = module\n","\n","    spec.loader.exec_module(module)\n","\n","    return module\n","\n","\n","# ============================================================\n","# LOAD AIS MODULES\n","# ============================================================\n","\n","def load_ais_modules():\n","\n","    fusion_module = import_module_from_file(\n","        \"project_fusion_detector\",\n","        AIS_DIR / \"fusion_detector.py\"\n","    )\n","\n","    tracker_module = import_module_from_file(\n","        \"project_tracker\",\n","        AIS_DIR / \"tracker.py\"\n","    )\n","\n","    geo_module = import_module_from_file(\n","        \"project_georeference\",\n","        AIS_DIR / \"georeference.py\"\n","    )\n","\n","    return (\n","        fusion_module,\n","        tracker_module,\n","        geo_module\n","    )\n","\n","\n","# ============================================================\n","# CAMERA / VISUAL DETECTION\n","# ============================================================\n","\n","def run_camera_detector(\n","    image_path,\n","    confidence=0.25\n","):\n","\n","    \"\"\"\n","    Detect vessels in one camera image.\n","\n","    Returns:\n","        pandas.DataFrame\n","    \"\"\"\n","\n","    from ultralytics import YOLO\n","\n","    image_path = Path(image_path)\n","\n","    if not image_path.exists():\n","\n","        raise FileNotFoundError(\n","            f\"Image not found:\\n{image_path}\"\n","        )\n","\n","    if not VISUAL_MODEL.exists():\n","\n","        raise FileNotFoundError(\n","            f\"Visual model not found:\\n{VISUAL_MODEL}\"\n","        )\n","\n","    print()\n","    print(\"=\" * 70)\n","    print(\"CAMERA / VISUAL DETECTION\")\n","    print(\"=\" * 70)\n","\n","    print(\n","        f\"Image : {image_path}\"\n","    )\n","\n","    print(\n","        f\"Model : {VISUAL_MODEL}\"\n","    )\n","\n","    model = YOLO(\n","        str(VISUAL_MODEL)\n","    )\n","\n","    results = model.predict(\n","        source=str(image_path),\n","        conf=confidence,\n","        verbose=False\n","    )\n","\n","    detections = []\n","\n","    for result in results:\n","\n","        if result.boxes is None:\n","            continue\n","\n","        for box in result.boxes:\n","\n","            x1, y1, x2, y2 = (\n","                box.xyxy[0]\n","                .cpu()\n","                .tolist()\n","            )\n","\n","            confidence_value = float(\n","                box.conf[0]\n","                .cpu()\n","                .item()\n","            )\n","\n","            class_id = int(\n","                box.cls[0]\n","                .cpu()\n","                .item()\n","            )\n","\n","            if hasattr(\n","                result,\n","                \"names\"\n","            ):\n","\n","                class_name = result.names.get(\n","                    class_id,\n","                    \"ship\"\n","                )\n","\n","            else:\n","\n","                class_name = \"ship\"\n","\n","            cx = (\n","                x1 + x2\n","            ) / 2.0\n","\n","            cy = (\n","                y1 + y2\n","            ) / 2.0\n","\n","            detections.append({\n","\n","                \"frame\": 0,\n","\n","                \"class\":\n","                    class_name,\n","\n","                \"source\":\n","                    \"camera\",\n","\n","                \"confidence\":\n","                    confidence_value,\n","\n","                \"x1\":\n","                    x1,\n","\n","                \"y1\":\n","                    y1,\n","\n","                \"x2\":\n","                    x2,\n","\n","                \"y2\":\n","                    y2,\n","\n","                \"cx\":\n","                    cx,\n","\n","                \"cy\":\n","                    cy\n","            })\n","\n","    df = pd.DataFrame(\n","        detections\n","    )\n","\n","    df.to_csv(\n","        SINGLE_IMAGE_DETECTIONS,\n","        index=False\n","    )\n","\n","    print(\n","        f\"Vessels detected : {len(df)}\"\n","    )\n","\n","    print(\n","        f\"Saved to         : \"\n","        f\"{SINGLE_IMAGE_DETECTIONS}\"\n","    )\n","\n","    return df\n","\n","\n","# ============================================================\n","# DISPLAY DETECTIONS\n","# ============================================================\n","\n","def display_detections(\n","    image_path,\n","    detections\n","):\n","\n","    \"\"\"\n","    Display image with detection boxes.\n","    \"\"\"\n","\n","    image_path = Path(\n","        image_path\n","    )\n","\n","    image = cv2.imread(\n","        str(image_path)\n","    )\n","\n","    if image is None:\n","\n","        raise ValueError(\n","            f\"Could not read image:\\n{image_path}\"\n","        )\n","\n","    image = cv2.cvtColor(\n","        image,\n","        cv2.COLOR_BGR2RGB\n","    )\n","\n","    plt.figure(\n","        figsize=(14, 9)\n","    )\n","\n","    plt.imshow(\n","        image\n","    )\n","\n","    for index, row in detections.iterrows():\n","\n","        x1 = float(\n","            row[\"x1\"]\n","        )\n","\n","        y1 = float(\n","            row[\"y1\"]\n","        )\n","\n","        x2 = float(\n","            row[\"x2\"]\n","        )\n","\n","        y2 = float(\n","            row[\"y2\"]\n","        )\n","\n","        confidence = float(\n","            row.get(\n","                \"confidence\",\n","                0.0\n","            )\n","        )\n","\n","        rectangle = plt.Rectangle(\n","            (x1, y1),\n","            x2 - x1,\n","            y2 - y1,\n","            fill=False,\n","            linewidth=2\n","        )\n","\n","        plt.gca().add_patch(\n","            rectangle\n","        )\n","\n","        label = (\n","            f\"Vessel {index + 1} \"\n","            f\"({confidence:.2f})\"\n","        )\n","\n","        plt.text(\n","            x1,\n","            max(\n","                0,\n","                y1 - 5\n","            ),\n","            label,\n","            fontsize=10,\n","            bbox=dict(\n","                facecolor=\"white\",\n","                alpha=0.7\n","            )\n","        )\n","\n","    plt.title(\n","        \"Vessel Detection\"\n","    )\n","\n","    plt.axis(\n","        \"off\"\n","    )\n","\n","    plt.tight_layout()\n","\n","    plt.show()\n","\n","\n","# ============================================================\n","# TRACKING\n","# ============================================================\n","\n","def run_tracking(\n","    detections_file,\n","    output_file\n","):\n","\n","    \"\"\"\n","    Run the existing VesselTracker.\n","    \"\"\"\n","\n","    (\n","        _,\n","        tracker_module,\n","        _\n","    ) = load_ais_modules()\n","\n","    VesselTracker = (\n","        tracker_module.VesselTracker\n","    )\n","\n","    print()\n","    print(\"=\" * 70)\n","    print(\"VESSEL TRACKING\")\n","    print(\"=\" * 70)\n","\n","    tracker = VesselTracker(\n","        max_age=5,\n","        min_hits=1,\n","        iou_threshold=0.3,\n","        max_center_distance=100\n","    )\n","\n","    tracker.track(\n","        str(detections_file),\n","        str(output_file)\n","    )\n","\n","    if not Path(\n","        output_file\n","    ).exists():\n","\n","        print(\n","            \"WARNING: Tracking output was not created.\"\n","        )\n","\n","        return pd.read_csv(\n","            detections_file\n","        )\n","\n","    tracked = pd.read_csv(\n","        output_file\n","    )\n","\n","    print(\n","        f\"Tracked detections : \"\n","        f\"{len(tracked)}\"\n","    )\n","\n","    if \"track_id\" in tracked.columns:\n","\n","        print(\n","            f\"Unique tracks      : \"\n","            f\"{tracked['track_id'].nunique()}\"\n","        )\n","\n","    return tracked\n","\n","\n","# ============================================================\n","# GEOREFERENCING\n","# ============================================================\n","\n","def run_georeferencing(\n","    tracked_file,\n","    output_file,\n","    image_width,\n","    image_height\n","):\n","\n","    \"\"\"\n","    Run the existing GeoReferencer.\n","    \"\"\"\n","\n","    (\n","        _,\n","        _,\n","        geo_module\n","    ) = load_ais_modules()\n","\n","    GeoReferencer = (\n","        geo_module.GeoReferencer\n","    )\n","\n","    print()\n","    print(\"=\" * 70)\n","    print(\"GEOREFERENCING\")\n","    print(\"=\" * 70)\n","\n","    if not TILE_BOUNDS.exists():\n","\n","        print(\n","            \"WARNING: tile bounds file not found.\"\n","        )\n","\n","        return pd.read_csv(\n","            tracked_file\n","        )\n","\n","    geo = GeoReferencer(\n","        str(TILE_BOUNDS)\n","    )\n","\n","    geo.process(\n","        str(tracked_file),\n","        str(output_file),\n","        image_width,\n","        image_height\n","    )\n","\n","    if not Path(\n","        output_file\n","    ).exists():\n","\n","        print(\n","            \"WARNING: georeferencing output \"\n","            \"was not created.\"\n","        )\n","\n","        return pd.read_csv(\n","            tracked_file\n","        )\n","\n","    georeferenced = pd.read_csv(\n","        output_file\n","    )\n","\n","    print(\n","        f\"Georeferenced detections : \"\n","        f\"{len(georeferenced)}\"\n","    )\n","\n","    return georeferenced\n","\n","\n","# ============================================================\n","# SINGLE-FRAME SPATIAL RISK\n","# ============================================================\n","\n","def calculate_spatial_risk(\n","    detections,\n","    critical_distance_pixels=80,\n","    high_distance_pixels=150,\n","    moderate_distance_pixels=250\n","):\n","\n","    \"\"\"\n","    Calculate proximity risk between vessels\n","    in the supplied image.\n","\n","    IMPORTANT:\n","    This is NOT CPA/TCPA.\n","\n","    It only measures image-space proximity.\n","    \"\"\"\n","\n","    if len(detections) <= 1:\n","\n","        return (\n","            \"SAFE\",\n","            0.0,\n","            None\n","        )\n","\n","    centers = detections[\n","        [\"cx\", \"cy\"]\n","    ].to_numpy(\n","        dtype=float\n","    )\n","\n","    minimum_distance = float(\n","        \"inf\"\n","    )\n","\n","    closest_pair = None\n","\n","    for i in range(\n","        len(centers)\n","    ):\n","\n","        for j in range(\n","            i + 1,\n","            len(centers)\n","        ):\n","\n","            distance = np.linalg.norm(\n","                centers[i] -\n","                centers[j]\n","            )\n","\n","            if distance < minimum_distance:\n","\n","                minimum_distance = (\n","                    distance\n","                )\n","\n","                closest_pair = (\n","                    i,\n","                    j\n","                )\n","\n","    if (\n","        minimum_distance\n","        <= critical_distance_pixels\n","    ):\n","\n","        risk_level = \"CRITICAL\"\n","\n","        risk_score = 1.0\n","\n","    elif (\n","        minimum_distance\n","        <= high_distance_pixels\n","    ):\n","\n","        risk_level = \"HIGH\"\n","\n","        risk_score = 0.8\n","\n","    elif (\n","        minimum_distance\n","        <= moderate_distance_pixels\n","    ):\n","\n","        risk_level = \"MODERATE\"\n","\n","        risk_score = 0.5\n","\n","    else:\n","\n","        risk_level = \"SAFE\"\n","\n","        risk_score = 0.1\n","\n","    closest_vessel = None\n","\n","    if closest_pair is not None:\n","\n","        closest_vessel = (\n","            closest_pair[1]\n","        )\n","\n","    return (\n","        risk_level,\n","        risk_score,\n","        closest_vessel\n","    )\n","\n","\n","# ============================================================\n","# LOAD AGENTIC NAVIGATION AGENT\n","# ============================================================\n","\n","def load_navigation_agent():\n","\n","    \"\"\"\n","    Load the existing AgenticNavigationAgent.\n","    \"\"\"\n","\n","    agent_file = (\n","        AGENTIC_DIR\n","        / \"agentic_navigation_agent.py\"\n","    )\n","\n","    if not agent_file.exists():\n","\n","        raise FileNotFoundError(\n","            f\"Agent file not found:\\n\"\n","            f\"{agent_file}\"\n","        )\n","\n","    module = import_module_from_file(\n","        \"project_agentic_navigation_agent\",\n","        agent_file\n","    )\n","\n","    if not hasattr(\n","        module,\n","        \"AgenticNavigationAgent\"\n","    ):\n","\n","        raise AttributeError(\n","            \"AgenticNavigationAgent class \"\n","            \"was not found.\"\n","        )\n","\n","    return (\n","        module.AgenticNavigationAgent\n","    )\n","\n","\n","# ============================================================\n","# CONSERVATIVE SINGLE-IMAGE AGENT\n","# ============================================================\n","\n","def conservative_single_frame_decision(\n","    risk_level\n","):\n","\n","    \"\"\"\n","    Fallback decision for a single image.\n","\n","    Because one image has no temporal information,\n","    encounter geometry cannot be reliably determined.\n","    \"\"\"\n","\n","    if risk_level == \"CRITICAL\":\n","\n","        return {\n","\n","            \"agent_decision\":\n","                \"STOP\",\n","\n","            \"agent_confidence\":\n","                0.75,\n","\n","            \"agent_reasoning\":\n","                (\n","                    \"Critical spatial proximity \"\n","                    \"detected. A single image does \"\n","                    \"not provide vessel motion, so \"\n","                    \"a conservative research \"\n","                    \"response is selected.\"\n","                )\n","        }\n","\n","    if risk_level == \"HIGH\":\n","\n","        return {\n","\n","            \"agent_decision\":\n","                \"SLOW_DOWN\",\n","\n","            \"agent_confidence\":\n","                0.65,\n","\n","            \"agent_reasoning\":\n","                (\n","                    \"High spatial proximity detected. \"\n","                    \"Temporal information is unavailable, \"\n","                    \"so a conservative speed-reduction \"\n","                    \"response is selected.\"\n","                )\n","        }\n","\n","    if risk_level == \"MODERATE\":\n","\n","        return {\n","\n","            \"agent_decision\":\n","                \"SLOW_DOWN\",\n","\n","            \"agent_confidence\":\n","                0.55,\n","\n","            \"agent_reasoning\":\n","                (\n","                    \"Moderate spatial proximity detected. \"\n","                    \"Additional frames are required to \"\n","                    \"determine vessel motion and encounter \"\n","                    \"geometry.\"\n","                )\n","        }\n","\n","    return {\n","\n","        \"agent_decision\":\n","            \"MAINTAIN_COURSE\",\n","\n","        \"agent_confidence\":\n","            0.80,\n","\n","        \"agent_reasoning\":\n","            (\n","                \"No significant spatial proximity \"\n","                \"detected in the supplied image.\"\n","            )\n","    }\n","\n","\n","# ============================================================\n","# AGENTIC REASONING\n","# ============================================================\n","\n","def run_agent(\n","    detections,\n","    risk_level,\n","    risk_score\n","):\n","\n","    \"\"\"\n","    Try to use the project's AgenticNavigationAgent.\n","\n","    If the existing agent requires temporal information\n","    that a single image does not provide, use the\n","    conservative single-frame reasoning path.\n","    \"\"\"\n","\n","    try:\n","\n","        AgenticNavigationAgent = (\n","            load_navigation_agent()\n","        )\n","\n","        agent = (\n","            AgenticNavigationAgent()\n","        )\n","\n","        context = {\n","\n","            \"frame\":\n","                0,\n","\n","            \"risk_level\":\n","                risk_level,\n","\n","            \"risk_score\":\n","                risk_score,\n","\n","            \"encounter_type\":\n","                \"UNCERTAIN\",\n","\n","            \"distance_km\":\n","                None,\n","\n","            \"current_distance_km\":\n","                None,\n","\n","            \"cpa_km\":\n","                None,\n","\n","            \"tcpa_minutes\":\n","                None,\n","\n","            \"neighbor_count\":\n","                max(\n","                    0,\n","                    len(detections) - 1\n","                ),\n","\n","            \"single_frame\":\n","                True\n","        }\n","\n","        # ----------------------------------------------------\n","        # TRY THINK()\n","        # ----------------------------------------------------\n","\n","        if hasattr(\n","            agent,\n","            \"think\"\n","        ):\n","\n","            try:\n","\n","                agent.think(\n","                    context\n","                )\n","\n","            except Exception:\n","\n","                pass\n","\n","        # ----------------------------------------------------\n","        # TRY DECIDE()\n","        # ----------------------------------------------------\n","\n","        if hasattr(\n","            agent,\n","            \"decide\"\n","        ):\n","\n","            try:\n","\n","                result = agent.decide(\n","                    context\n","                )\n","\n","                if isinstance(\n","                    result,\n","                    dict\n","                ):\n","\n","                    decision = dict(\n","                        result\n","                    )\n","\n","                    if (\n","                        \"agent_decision\"\n","                        not in decision\n","                        and\n","                        \"action\"\n","                        in decision\n","                    ):\n","\n","                        decision[\n","                            \"agent_decision\"\n","                        ] = decision[\n","                            \"action\"\n","                        ]\n","\n","                    if (\n","                        \"agent_reasoning\"\n","                        not in decision\n","                        and\n","                        \"reasoning\"\n","                        in decision\n","                    ):\n","\n","                        decision[\n","                            \"agent_reasoning\"\n","                        ] = decision[\n","                            \"reasoning\"\n","                        ]\n","\n","                    return decision\n","\n","            except Exception as error:\n","\n","                print(\n","                    \"Existing agent interface \"\n","                    \"could not consume the \"\n","                    \"single-frame context.\"\n","                )\n","\n","                print(\n","                    f\"Reason: {error}\"\n","                )\n","\n","    except Exception as error:\n","\n","        print(\n","            \"Existing AgenticNavigationAgent \"\n","            \"could not be loaded.\"\n","        )\n","\n","        print(\n","            f\"Reason: {error}\"\n","        )\n","\n","    # --------------------------------------------------------\n","    # FALLBACK\n","    # --------------------------------------------------------\n","\n","    return conservative_single_frame_decision(\n","        risk_level\n","    )\n","\n","\n","# ============================================================\n","# SAVE DECISION\n","# ============================================================\n","\n","def save_decision(\n","    image_path,\n","    detections,\n","    risk_level,\n","    risk_score,\n","    agent_result\n","):\n","\n","    decision = {\n","\n","        \"image\":\n","            str(image_path),\n","\n","        \"vessel_count\":\n","            len(detections),\n","\n","        \"risk_level\":\n","            risk_level,\n","\n","        \"risk_score\":\n","            risk_score,\n","\n","        \"encounter_type\":\n","            \"UNCERTAIN\",\n","\n","        \"agent_decision\":\n","            agent_result.get(\n","                \"agent_decision\",\n","                \"UNKNOWN\"\n","            ),\n","\n","        \"agent_confidence\":\n","            agent_result.get(\n","                \"agent_confidence\",\n","                agent_result.get(\n","                    \"confidence\",\n","                    0.0\n","                )\n","            ),\n","\n","        \"agent_reasoning\":\n","            agent_result.get(\n","                \"agent_reasoning\",\n","                agent_result.get(\n","                    \"reasoning\",\n","                    \"\"\n","                )\n","            )\n","    }\n","\n","    df = pd.DataFrame(\n","        [decision]\n","    )\n","\n","    df.to_csv(\n","        SINGLE_IMAGE_DECISION,\n","        index=False\n","    )\n","\n","    return df\n","\n","\n","# ============================================================\n","# PRINT FINAL RESULT\n","# ============================================================\n","\n","def print_result(\n","    image_path,\n","    detections,\n","    risk_level,\n","    risk_score,\n","    agent_result\n","):\n","\n","    print()\n","    print(\"=\" * 70)\n","    print(\"AGENTIC NAVIGATION RESULT\")\n","    print(\"=\" * 70)\n","\n","    print(\n","        f\"Image              : {image_path}\"\n","    )\n","\n","    print(\n","        f\"Vessels detected   : {len(detections)}\"\n","    )\n","\n","    print(\n","        f\"Spatial risk       : {risk_level}\"\n","    )\n","\n","    print(\n","        f\"Risk score         : {risk_score:.2f}\"\n","    )\n","\n","    print(\n","        \"Encounter type     : \"\n","        \"UNCERTAIN (single image)\"\n","    )\n","\n","    print(\n","        f\"Agent decision     : \"\n","        f\"{agent_result.get('agent_decision', 'UNKNOWN')}\"\n","    )\n","\n","    print(\n","        f\"Agent confidence   : \"\n","        f\"{agent_result.get('agent_confidence', 0.0):.2f}\"\n","    )\n","\n","    print()\n","\n","    print(\n","        \"Agent reasoning:\"\n","    )\n","\n","    print(\n","        agent_result.get(\n","            \"agent_reasoning\",\n","            \"No reasoning available.\"\n","        )\n","    )\n","\n","    print()\n","    print(\n","        \"Decision file:\"\n","    )\n","\n","    print(\n","        SINGLE_IMAGE_DECISION\n","    )\n","\n","    print(\"=\" * 70)\n","\n","\n","# ============================================================\n","# MAIN CAMERA IMAGE PIPELINE\n","# ============================================================\n","\n","def run_camera_image(\n","    image_path,\n","    run_tracking_stage=True,\n","    run_georeferencing_stage=True,\n","    display=True\n","):\n","\n","    \"\"\"\n","    MAIN FUNCTION.\n","\n","    Give this function one ship image.\n","\n","    Example:\n","\n","        result = run_camera_image(\n","            \"/content/drive/MyDrive/ResearchProject/test_images/ship.jpg\"\n","        )\n","    \"\"\"\n","\n","    image_path = Path(\n","        image_path\n","    )\n","\n","    if not image_path.exists():\n","\n","        raise FileNotFoundError(\n","            f\"Image does not exist:\\n\"\n","            f\"{image_path}\"\n","        )\n","\n","    # --------------------------------------------------------\n","    # READ IMAGE\n","    # --------------------------------------------------------\n","\n","    image = cv2.imread(\n","        str(image_path)\n","    )\n","\n","    if image is None:\n","\n","        raise ValueError(\n","            f\"Could not read image:\\n\"\n","            f\"{image_path}\"\n","        )\n","\n","    image_height, image_width = (\n","        image.shape[:2]\n","    )\n","\n","    print()\n","    print(\"=\" * 70)\n","    print(\"IMAGE → NAVIGATION PIPELINE\")\n","    print(\"=\" * 70)\n","\n","    print(\n","        f\"Image width  : {image_width}\"\n","    )\n","\n","    print(\n","        f\"Image height : {image_height}\"\n","    )\n","\n","    # --------------------------------------------------------\n","    # STEP 1 — DETECTION\n","    # --------------------------------------------------------\n","\n","    detections = run_camera_detector(\n","        image_path\n","    )\n","\n","    # --------------------------------------------------------\n","    # DISPLAY IMAGE\n","    # --------------------------------------------------------\n","\n","    if display:\n","\n","        display_detections(\n","            image_path,\n","            detections\n","        )\n","\n","    # --------------------------------------------------------\n","    # NO VESSELS\n","    # --------------------------------------------------------\n","\n","    if detections.empty:\n","\n","        result = {\n","\n","            \"agent_decision\":\n","                \"MAINTAIN_COURSE\",\n","\n","            \"agent_confidence\":\n","                0.90,\n","\n","            \"agent_reasoning\":\n","                (\n","                    \"No vessel was detected \"\n","                    \"in the supplied image.\"\n","                )\n","        }\n","\n","        decision_df = save_decision(\n","            image_path,\n","            detections,\n","            \"SAFE\",\n","            0.0,\n","            result\n","        )\n","\n","        print_result(\n","            image_path,\n","            detections,\n","            \"SAFE\",\n","            0.0,\n","            result\n","        )\n","\n","        return {\n","\n","            \"detections\":\n","                detections,\n","\n","            \"risk_level\":\n","                \"SAFE\",\n","\n","            \"risk_score\":\n","                0.0,\n","\n","            \"agent_decision\":\n","                \"MAINTAIN_COURSE\",\n","\n","            \"agent_confidence\":\n","                0.90,\n","\n","            \"agent_reasoning\":\n","                result[\n","                    \"agent_reasoning\"\n","                ],\n","\n","            \"decision_table\":\n","                decision_df\n","        }\n","\n","    # --------------------------------------------------------\n","    # STEP 2 — TRACKING\n","    # --------------------------------------------------------\n","\n","    tracked = detections.copy()\n","\n","    if run_tracking_stage:\n","\n","        try:\n","\n","            tracked = run_tracking(\n","                SINGLE_IMAGE_DETECTIONS,\n","                SINGLE_IMAGE_TRACKS\n","            )\n","\n","        except Exception as error:\n","\n","            print()\n","            print(\n","                \"WARNING: Tracking failed.\"\n","            )\n","\n","            print(\n","                error\n","            )\n","\n","            tracked = detections.copy()\n","\n","    # --------------------------------------------------------\n","    # STEP 3 — GEOREFERENCING\n","    # --------------------------------------------------------\n","\n","    georeferenced = tracked.copy()\n","\n","    if run_georeferencing_stage:\n","\n","        try:\n","\n","            georeferenced = run_georeferencing(\n","                SINGLE_IMAGE_TRACKS,\n","                SINGLE_IMAGE_GEO,\n","                image_width,\n","                image_height\n","            )\n","\n","        except Exception as error:\n","\n","            print()\n","            print(\n","                \"WARNING: Georeferencing failed.\"\n","            )\n","\n","            print(\n","                error\n","            )\n","\n","            georeferenced = tracked.copy()\n","\n","    # --------------------------------------------------------\n","    # STEP 4 — SPATIAL RISK\n","    # --------------------------------------------------------\n","\n","    (\n","        risk_level,\n","        risk_score,\n","        closest_vessel\n","    ) = calculate_spatial_risk(\n","        detections\n","    )\n","\n","    print()\n","    print(\"=\" * 70)\n","    print(\"SPATIAL RISK\")\n","    print(\"=\" * 70)\n","\n","    print(\n","        f\"Risk level : {risk_level}\"\n","    )\n","\n","    print(\n","        f\"Risk score : {risk_score:.2f}\"\n","    )\n","\n","    # --------------------------------------------------------\n","    # STEP 5 — AGENTIC REASONING\n","    # --------------------------------------------------------\n","\n","    print()\n","    print(\"=\" * 70)\n","    print(\"AGENTIC REASONING\")\n","    print(\"=\" * 70)\n","\n","    agent_result = run_agent(\n","        detections,\n","        risk_level,\n","        risk_score\n","    )\n","\n","    # --------------------------------------------------------\n","    # STEP 6 — SAVE\n","    # --------------------------------------------------------\n","\n","    decision_df = save_decision(\n","        image_path,\n","        detections,\n","        risk_level,\n","        risk_score,\n","        agent_result\n","    )\n","\n","    # --------------------------------------------------------\n","    # STEP 7 — FINAL OUTPUT\n","    # --------------------------------------------------------\n","\n","    print_result(\n","        image_path,\n","        detections,\n","        risk_level,\n","        risk_score,\n","        agent_result\n","    )\n","\n","    return {\n","\n","        \"image\":\n","            str(image_path),\n","\n","        \"detections\":\n","            detections,\n","\n","        \"tracked\":\n","            tracked,\n","\n","        \"georeferenced\":\n","            georeferenced,\n","\n","        \"risk_level\":\n","            risk_level,\n","\n","        \"risk_score\":\n","            risk_score,\n","\n","        \"closest_vessel\":\n","            closest_vessel,\n","\n","        \"agent_decision\":\n","            agent_result.get(\n","                \"agent_decision\"\n","            ),\n","\n","        \"agent_confidence\":\n","            agent_result.get(\n","                \"agent_confidence\"\n","            ),\n","\n","        \"agent_reasoning\":\n","            agent_result.get(\n","                \"agent_reasoning\"\n","            ),\n","\n","        \"decision_table\":\n","            decision_df\n","    }\n","\n","\n","# ============================================================\n","# RADAR + CAMERA FUSION\n","# ============================================================\n","\n","def run_fusion_pair(\n","    radar_image,\n","    camera_image,\n","    display_c