========================\n","\n","PROJECT_ROOT = \"/content/drive/MyDrive/ResearchProject\"\n","\n","AIS_DIR = os.path.join(\n","    PROJECT_ROOT,\n","    \"ais\"\n",")\n","\n","AGENT_DIR = os.path.join(\n","    PROJECT_ROOT,\n","    \"agentic_ai\"\n",")\n","\n","MODELS_DIR = os.path.join(\n","    PROJECT_ROOT,\n","    \"models\"\n",")\n","\n","\n","# ============================================================\n","# ADD MODULE PATHS\n","# ============================================================\n","\n","if AIS_DIR not in sys.path:\n","    sys.path.insert(0, AIS_DIR)\n","\n","if AGENT_DIR not in sys.path:\n","    sys.path.insert(0, AGENT_DIR)\n","\n","\n","# ============================================================\n","# EXISTING RESEARCH FILES\n","# ============================================================\n","\n","RADAR_MODEL = os.path.join(\n","    MODELS_DIR,\n","    \"best_model\",\n","    \"best_ship_detector.pt\"\n",")\n","\n","VISUAL_MODEL = os.path.join(\n","    MODELS_DIR,\n","    \"seedrones\",\n","    \"best_seedrones_detector.pt\"\n",")\n","\n","TILE_BOUNDS = os.path.join(\n","    AIS_DIR,\n","    \"tile_bounds_los_angeles.csv\"\n",")\n","\n","AIS_FILE = os.path.join(\n","    AIS_DIR,\n","    \"clean_ais.csv\"\n",")\n","\n","INTRUSION_ZONES = os.path.join(\n","    AGENT_DIR,\n","    \"intrusion_zones.csv\"\n",")\n","\n","\n","# ============================================================\n","# CHECK FILES\n","# ============================================================\n","\n","required_files = {\n","    \"Radar model\": RADAR_MODEL,\n","    \"Visual model\": VISUAL_MODEL,\n","    \"Tile bounds\": TILE_BOUNDS,\n","    \"AIS file\": AIS_FILE,\n","    \"Intrusion zones\": INTRUSION_ZONES,\n","}\n","\n","for name, path in required_files.items():\n","\n","    if not os.path.exists(path):\n","\n","        raise FileNotFoundError(\n","            f\"{name} not found:\\n{path}\"\n","        )\n","\n","\n","# ============================================================\n","# IMPORT YOUR EXISTING RESEARCH MODULES\n","# ============================================================\n","\n","from fusion_detector import FusionDetector\n","from georeference import GeoReferencer\n","from matcher import MultiVesselAISMatcher\n","from intrusion_detector import IntrusionDetector\n","from encounter_classifier import process_frame\n","from navigation_decision import NavigationDecision\n","from navigation_command import NavigationCommand\n","\n","\n","# ============================================================\n","# SINGLE-FRAME TRACKING\n","# ============================================================\n","\n","def create_single_frame_tracks(\n","    fusion_file,\n","    tracking_file\n","):\n","\n","    fusion_df = pd.read_csv(\n","        fusion_file\n","    )\n","\n","    if fusion_df.empty:\n","\n","        raise RuntimeError(\n","            \"Fusion produced zero detections.\"\n","        )\n","\n","    tracked_df = fusion_df.copy()\n","\n","    # Each detection becomes a temporary track.\n","    tracked_df[\"track_id\"] = (\n","        tracked_df.index + 1\n","    )\n","\n","    # No temporal information exists\n","    # because this test contains one frame.\n","    tracked_df[\"movement_pixels\"] = 0.0\n","    tracked_df[\"heading_deg\"] = 0.0\n","    tracked_df[\"track_hits\"] = 1\n","\n","    tracked_df.to_csv(\n","        tracking_file,\n","        index=False\n","    )\n","\n","    return tracked_df\n","\n","\n","# ============================================================\n","# ENCOUNTER ANALYSIS\n","# ============================================================\n","\n","def run_encounter_analysis(\n","    input_file,\n","    output_file\n","):\n","\n","    df = pd.read_csv(\n","        input_file\n","    )\n","\n","    if df.empty:\n","\n","        raise RuntimeError(\n","            \"No data available for encounter analysis.\"\n","        )\n","\n","    results = []\n","\n","    # --------------------------------------------------------\n","    # Process every frame\n","    # --------------------------------------------------------\n","\n","    for frame in sorted(\n","        df[\"frame\"].unique()\n","    ):\n","\n","        frame_df = df[\n","            df[\"frame\"] == frame\n","        ].copy()\n","\n","        try:\n","\n","            result = process_frame(\n","                frame_df\n","            )\n","\n","            if isinstance(\n","                result,\n","                pd.DataFrame\n","            ):\n","\n","                results.extend(\n","                    result.to_dict(\n","                        \"records\"\n","                    )\n","                )\n","\n","            elif isinstance(\n","                result,\n","                list\n","            ):\n","\n","                results.extend(\n","                    result\n","                )\n","\n","            elif isinstance(\n","                result,\n","                dict\n","            ):\n","\n","                results.append(\n","                    result\n","                )\n","\n","        except Exception:\n","\n","            # A single image has no temporal encounter.\n","            pass\n","\n","\n","    # --------------------------------------------------------\n","    # Single-frame fallback\n","    # --------------------------------------------------------\n","\n","    if len(results) == 0:\n","\n","        result_df = df.copy()\n","\n","        result_df[\"encounter_type\"] = (\n","            \"UNCERTAIN\"\n","        )\n","\n","        result_df[\"risk_level\"] = (\n","            \"UNKNOWN\"\n","        )\n","\n","        result_df[\"recommended_action\"] = (\n","            \"MAINTAIN_COURSE\"\n","        )\n","\n","    else:\n","\n","        result_df = pd.DataFrame(\n","            results\n","        )\n","\n","\n","    result_df.to_csv(\n","        output_file,\n","        index=False\n","    )\n","\n","    return result_df\n","\n","\n","# ============================================================\n","# NAVIGATION DECISION\n","# ============================================================\n","\n","def run_navigation(\n","    encounter_file,\n","    navigation_file,\n","    command_file\n","):\n","\n","    df = pd.read_csv(\n","        encounter_file\n","    )\n","\n","    navigation = NavigationDecision()\n","\n","    navigation_records = []\n","\n","\n","    # --------------------------------------------------------\n","    # Navigation decision\n","    # --------------------------------------------------------\n","\n","    for _, row in df.iterrows():\n","\n","        record = row.to_dict()\n","\n","        try:\n","\n","            decision = navigation.decide(\n","                row\n","            )\n","\n","            if isinstance(\n","                decision,\n","                dict\n","            ):\n","\n","                record.update(\n","                    decision\n","                )\n","\n","            else:\n","\n","                record[\n","                    \"navigation_decision\"\n","                ] = decision\n","\n","        except Exception:\n","\n","            record[\n","                \"navigation_decision\"\n","            ] = \"MAINTAIN_COURSE\"\n","\n","        navigation_records.append(\n","            record\n","        )\n","\n","\n","    navigation_df = pd.DataFrame(\n","        navigation_records\n","    )\n","\n","    navigation_df.to_csv(\n","        navigation_file,\n","        index=False\n","    )\n","\n","\n","    # --------------------------------------------------------\n","    # Navigation command\n","    # --------------------------------------------------------\n","\n","    command_generator = NavigationCommand()\n","\n","    command_records = []\n","\n","\n","    for _, row in navigation_df.iterrows():\n","\n","        record = row.to_dict()\n","\n","        try:\n","\n","            command = (\n","                command_generator.generate_command(\n","                    row\n","                )\n","            )\n","\n","            if isinstance(\n","                command,\n","                dict\n","            ):\n","\n","                record.update(\n","                    command\n","                )\n","\n","            else:\n","\n","                record[\"command\"] = command\n","\n","        except Exception:\n","\n","            record[\n","                \"command\"\n","            ] = \"MAINTAIN_COURSE\"\n","\n","        command_records.append(\n","            record\n","        )\n","\n","\n","    command_df = pd.DataFrame(\n","        command_records\n","    )\n","\n","    command_df.to_csv(\n","        command_file,\n","        index=False\n","    )\n","\n","    return navigation_df, command_df\n","\n","\n","# ============================================================\n","# FINAL RESULT\n","# ============================================================\n","\n","def extract_final_result(\n","    intrusion_df,\n","    encounter_df,\n","    navigation_df,\n","    command_df\n","):\n","\n","    # --------------------------------------------------------\n","    # Start with defaults\n","    # --------------------------------------------------------\n","\n","    final = {\n","        \"intrusion_type\": \"NONE\",\n","        \"severity\": \"UNKNOWN\",\n","        \"encounter_type\": \"UNCERTAIN\",\n","        \"risk_level\": \"UNKNOWN\",\n","        \"risk_score\": \"UNKNOWN\",\n","        \"navigation\": \"MAINTAIN_COURSE\",\n","        \"command\": \"MAINTAIN_COURSE\"\n","    }\n","\n","\n","    # --------------------------------------------------------\n","    # Intrusion\n","    # --------------------------------------------------------\n","\n","    if not intrusion_df.empty:\n","\n","        row = intrusion_df.iloc[-1]\n","\n","        if (\n","            \"intrusion_status\"\n","            in row.index\n","        ):\n","\n","            final[\"intrusion_type\"] = (\n","                row[\"intrusion_status\"]\n","            )\n","\n","        if (\n","            \"alert_level\"\n","            in row.index\n","        ):\n","\n","            final[\"severity\"] = (\n","                row[\"alert_level\"]\n","            )\n","\n","        if (\n","            \"intrusion_zone\"\n","            in row.index\n","        ):\n","\n","            zone = row[\"intrusion_zone\"]\n","\n","            if pd.notna(zone):\n","\n","                final[\"intrusion_zone\"] = zone\n","\n","\n","    # --------------------------------------------------------\n","    # Encounter\n","    # --------------------------------------------------------\n","\n","    if not encounter_df.empty:\n","\n","        row = encounter_df.iloc[-1]\n","\n","        if (\n","            \"encounter_type\"\n","            in row.index\n","        ):\n","\n","            final[\"encounter_type\"] = (\n","                row[\"encounter_type\"]\n","            )\n","\n","        if (\n","            \"risk_level\"\n","            in row.index\n","        ):\n","\n","            final[\"risk_level\"] = (\n","                row[\"risk_level\"]\n","            )\n","\n","        if (\n","            \"risk_score\"\n","            in row.index\n","        ):\n","\n","            final[\"risk_score\"] = (\n","                row[\"risk_score\"]\n","            )\n","\n","        elif (\n","            \"recommended_action\"\n","            in row.index\n","        ):\n","\n","            # Keep risk score unknown if the\n","            # existing module does not provide it.\n","            pass\n","\n","\n","    # --------------------------------------------------------\n","    # Navigation\n","    # --------------------------------------------------------\n","\n","    if not navigation_df.empty:\n","\n","        row = navigation_df.iloc[-1]\n","\n","        if (\n","            \"navigation_decision\"\n","            in row.index\n","        ):\n","\n","            final[\"navigation\"] = (\n","                row[\"navigation_decision\"]\n","            )\n","\n","        elif (\n","            \"recommended_action\"\n","            in row.index\n","        ):\n","\n","            final[\"navigation\"] = (\n","                row[\"recommended_action\"]\n","            )\n","\n","\n","    # --------------------------------------------------------\n","    # Command\n","    # --------------------------------------------------------\n","\n","    if not command_df.empty:\n","\n","        row = command_df.iloc[-1]\n","\n","        if \"command\" in row.index:\n","\n","            final[\"command\"] = row[\"command\"]\n","\n","        elif \"command_action\" in row.index:\n","\n","            final[\"command\"] = row[\n","                \"command_action\"\n","            ]\n","\n","\n","    return final\n","\n","\n","# ============================================================\n","# MAIN END-TO-END FUNCTION\n","# ============================================================\n","\n","def analyze_inputs(\n","    radar_image,\n","    camera_image\n","):\n","\n","    # ========================================================\n","    # VALIDATE INPUTS\n","    # ========================================================\n","\n","    if not os.path.exists(\n","        radar_image\n","    ):\n","\n","        raise FileNotFoundError(\n","            f\"Radar image not found:\\n{radar_image}\"\n","        )\n","\n","    if not os.path.exists(\n","        camera_image\n","    ):\n","\n","        raise FileNotFoundError(\n","            f\"Camera image not found:\\n{camera_image}\"\n","        )\n","\n","\n","    # ========================================================\n","    # CREATE UNIQUE TEST DIRECTORY\n","    # ========================================================\n","\n","    timestamp = datetime.now().strftime(\n","        \"%Y%m%d_%H%M%S_%f\"\n","    )\n","\n","    test_dir = os.path.join(\n","        PROJECT_ROOT,\n","        \"experiments\",\n","        f\"test_{timestamp}\"\n","    )\n","\n","    os.makedirs(\n","        test_dir,\n","        exist_ok=True\n","    )\n","\n","\n","    radar_dir = os.path.join(\n","        test_dir,\n","        \"radar\"\n","    )\n","\n","    camera_dir = os.path.join(\n","        test_dir,\n","        \"camera\"\n","    )\n","\n","    os.makedirs(\n","        radar_dir,\n","        exist_ok=True\n","    )\n","\n","    os.makedirs(\n","        camera_dir,\n","        exist_ok=True\n","    )\n","\n","\n","    # ========================================================\n","    # COPY INPUT IMAGES\n","    # ========================================================\n","\n","    radar_test = os.path.join(\n","        radar_dir,\n","        \"000000.png\"\n","    )\n","\n","    camera_test = os.path.join(\n","        camera_dir,\n","        \"000000.jpg\"\n","    )\n","\n","    shutil.copy2(\n","        radar_image,\n","        radar_test\n","    )\n","\n","    shutil.copy2(\n","        camera_image,\n","        camera_test\n","    )\n","\n","\n","    # ========================================================\n","    # 1. FUSION\n","    # ========================================================\n","\n","    fusion_file = os.path.join(\n","        test_dir,\n","        \"fusion.csv\"\n","    )\n","\n","    detector = FusionDetector(\n","        RADAR_MODEL,\n","        VISUAL_MODEL\n","    )\n","\n","    fusion_df = detector.detect_folder(\n","        radar_dir,\n","        camera_dir,\n","        fusion_file\n","    )\n","\n","    if (\n","        fusion_df is None\n","        or fusion_df.empty\n","    ):\n","\n","        raise RuntimeError(\n","            \"Fusion produced zero detections.\"\n","        )\n","\n","\n","    # ========================================================\n","    # 2. SINGLE-FRAME TRACKING\n","    # ========================================================\n","\n","    tracking_file = os.path.join(\n","        test_dir,\n","        \"tracking.csv\"\n","    )\n","\n","    tracked_df = create_single_frame_tracks(\n","        fusion_file,\n","        tracking_file\n","    )\n","\n","\n","    # ========================================================\n","    # 3. LOS ANGELES GEOREFERENCING\n","    # ========================================================\n","\n","    georeferenced_file = os.path.join(\n","        test_dir,\n","        \"georeferenced.csv\"\n","    )\n","\n","    georef = GeoReferencer(\n","        TILE_BOUNDS\n","    )\n","\n","    georeferenced_df = georef.process(\n","        tracking_file,\n","        georeferenced_file\n","    )\n","\n","    if (\n","        georeferenced_df is None\n","        or georeferenced_df.empty\n","    ):\n","\n","        raise RuntimeError(\n","            \"Georeferencing produced zero records.\"\n","        )\n","\n","\n","    # ========================================================\n","    # 4. AIS MATCHING\n","    # ========================================================\n","\n","    matched_file = os.path.join(\n","        test_dir,\n","        \"matched.csv\"\n","    )\n","\n","    matcher = MultiVesselAISMatcher(\n","        max_distance_km=5.0,\n","        reliable_distance_km=1.0,\n","        moderate_distance_km=2.0\n","    )\n","\n","    matched_df = matcher.match(\n","        georeferenced_file,\n","        AIS_FILE,\n","        matched_file\n","    )\n","\n","    # --------------------------------------------------------\n","    # AIS matcher may return no matches.\n","    # Keep the detection rather than stopping the pipeline.\n","    # --------------------------------------------------------\n","\n","    if (\n","        matched_df is None\n","        or matched_df.empty\n","    ):\n","\n","        matched_df = georeferenced_df.copy()\n","\n","        matched_df[\"ais_match\"] = False\n","\n","        matched_df[\"match_quality\"] = (\n","            \"unknown\"\n","        )\n","\n","        matched_df.to_csv(\n","    